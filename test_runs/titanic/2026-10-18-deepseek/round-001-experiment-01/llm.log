\n\npre = ColumnTransformer([\n    ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_cols),\n    ("af", Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),\n    ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                      ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n])\nclf = Pipeline([("pre", pre), ("lr", LogisticRegression(max_iter=2000, random_state=seed))])\nclf.fit(X_tr, y_tr)\n\nval_pred = (clf.predict_proba(val_f)[:, 1] >= 0.5).astype(int)\npd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(\n    "work/val_predictions.csv", index=False)\n\ntest_pred = (clf.predict_proba(te_f)[:, 1] >= 0.5).astype(int)\npp = pd.DataFrame({"PassengerId": te_f["PassengerId"].values, "Survived": test_pred})\npp.to_csv("predictions.csv", index=False)\n\njson.dump({"model": "LR + Title/FamilySize/IsAlone/Deck, scaled", "seed": seed,\n           "features": num_cols + af_cols + cat_cols}, open("work/metrics.json", "w"), indent=2)\njoblib.dump(clf, "work/model_final.joblib")\nopen("work/README.txt", "w").write(\n    "Inference: load model_final.joblib; predict_proba[:,1] >= 0.5 -> 1.\\n"\n    "Features: scaled Pclass,SibSp,Parch,FamilySize,IsAlone; Age/Fare median(+indicator) scaled; "\n    "Sex/Embarked(missing->\'M\')/Title/Deck one-hot (Deck from Cabin first char, missing->X). "\n    "Trained on all 712 train rows. Seed 42, CPU only.")\n\nvp = pd.read_csv("work/val_predictions.csv")\nassert vp["PassengerId"].tolist() == val_ids and len(vp) == 179\nassert len(pp) == 418 and pp["PassengerId"].tolist() == te_f["PassengerId"].tolist()\nassert set(pp["Survived"].unique()) <= {0, 1}\nprint("Deck train dist:", tr_f["Deck"].value_counts().to_dict())\nprint("val rows", len(vp), "test rows", len(pp), "test pos rate", pp["Survived"].mean().round(3))\n</code>\n<validation_prediction_file>work/val_predictions.csv</valid