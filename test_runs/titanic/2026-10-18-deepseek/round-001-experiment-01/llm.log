mpleImputer(strategy="median"), num_cols),\n    ("af", SimpleImputer(strategy="median", add_indicator=True), af_cols),\n    ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                      ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n])\nclf = Pipeline([("pre", pre),\n                ("lr", LogisticRegression(max_iter=1000, random_state=seed))])\nclf.fit(X_tr, y_tr)\n\n# validation predictions (no labels available locally)\nval_pred = (clf.predict_proba(val)[:, 1] >= 0.5).astype(int)\npd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(\n    "work/val_predictions.csv", index=False)\n\n# test predictions\ntest_pred = (clf.predict_proba(test)[:, 1] >= 0.5).astype(int)\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred})\npp.to_csv("predictions.csv", index=False)\n\n# training-fit sanity (in-sample), informational only\ntr_pred = (clf.predict_proba(X_tr)[:, 1] >= 0.5).astype(int)\nprint("in-sample acc:", (tr_pred == y_tr).mean().round(4))\n\njson.dump({"model": "LogisticRegression baseline", "seed": seed,\n           "trained_on": "train_data/train.csv (712 rows)",\n           "validation": "validation_data/validation.csv (179 rows)",\n           "note": "val accuracy computed by external evaluator"},\n          open("work/metrics.json", "w"), indent=2)\njoblib.dump(clf, "work/model_baseline.joblib")\nopen("work/README.txt", "w").write(\n    "Inference: load model_baseline.joblib; predict_proba[:,1] >= 0.5 -> 1.\\n"\n    "Trained on all 712 train rows. Sex/Embarked one-hot (Embarked missing->\'M\'); "\n    "Age/Fare median-imputed with missing indicators; Pclass/SibSp/Parch numeric. "\n    "Seed 42, CPU only.")\n\nvp = pd.read_csv("work/val_predictions.csv")\nassert vp["PassengerId"].tolist() == val_ids and len(vp) == 179\nassert len(pp) == 418 and pp["PassengerId"].tolist() == test["PassengerId"].tolist()\nassert set(pp["Survived"].unique()) <= {0, 1}\nprint("val ro