lass rate (~0.62) and the Sex-only rule (~0.74–0.78). This is the reference for all later rounds.\n\nPredictions: predicted probability ≥ 0.5 → 1, else 0. Produce val_predictions.csv (PassengerId, Survived) aligned to the fixed validation IDs and predictions.csv (418 rows, header, exactly PassengerId + Survived, int 0/1, test order preserved, no index). Save metrics.json (val accuracy, floors), the fitted pipeline via joblib, and a short README inference note. CPU only, seed 42, n_jobs limited to ≤4, runtime a few seconds.</experiment>\n<code_outline>import os, json, joblib, numpy as np, pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.linear_model import LogisticRegression\n\nseed = 42\nbase = "../input/data"\ntrain = pd.read_csv(f"{base}/train_data/train.csv")\ntest = pd.read_csv(f"{base}/predict_data/test.csv")\nos.makedirs("work", exist_ok=True)\n\n# --- data quality checks ---\nassert train["PassengerId"].is_unique and test["PassengerId"].is_unique\nassert set(train["Survived"].unique()) <= {0, 1}\nprint(train.isna().mean())\nprint(test.isna().mean())\n\n# --- fixed split (once) ---\nX = train.drop(columns=["Survived"])\ny = train["Survived"]\nX_tr, X_val, y_tr, y_val = train_test_split(\n    X, y, test_size=0.2, random_state=seed, stratify=y)\nval_ids = X_val["PassengerId"].tolist()\njson.dump(val_ids, open("work/val_ids.json", "w"))\n\n# --- preprocessing ---\nnum_cols = ["Pclass", "SibSp", "Parch"]\nage_fare = ["Age", "Fare"]\ncat_cols = ["Sex", "Embarked"]\n\nnum_pipe = Pipeline([\n    ("imp", SimpleImputer(strategy="median")),\n    ("sc", StandardScaler()),\n])\n\npre = ColumnTransformer([\n    ("num", num_pipe, num_cols),\n    ("age", Pipeline([("imp", SimpleImputer(strategy="median")),\n                      ("ind", __import__("sklearn.impute", fromlist=["MissingIndicator"]).MissingIndicator(features="missing")),\n                      ("sc", StandardScaler())]), age_fare),\n    ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                      ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n])\n\nclf = Pipeline([\n    ("pre", pre),\n    ("lr", LogisticRegression(max_iter=1000, random_state=seed, n_jobs=1)),\n])\nclf.fit(X_tr, y_tr)\n\n# --- validation ---\nval_pred = (clf.predict_proba(X_val)[:, 1] >= 0.5).astype(int)\nval_acc = float((val_pred == y_val.values).mean())\nmaj_rate = float(y_val.value_counts(normalize=True).max())\nprint("val acc", val_acc, "majority", maj_rate)\n\npd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(\n    "work/val_predictions.csv", index=False)\n\n# --- test predictions ---\ntest_pred = (clf.predict_proba(test)[:, 1] >= 0.5).astype(int)\npd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred}).to_csv(\n    "work/predictions.csv", index=False)\n\n# --- artifacts ---\njson.dump({"val_accuracy": val_acc, "majority_baseline": maj_rate,\n           "model": "LogisticRegression baseline"},\n          open("work/metrics.json", "w"), indent=2)\njoblib.dump(clf, "work/model_baseline.joblib")\nopen("work/README.txt", "w").write(\n    "Inference: load model_baseline.joblib; predict_proba[:,1] >= 0.5 -> 1. "\n    "Preprocessing fitted on 712 train rows only.")\nprint(open("work/predictions.csv").readline(), len(test_pred))</code_outline>\n\nRead local data from ../input/data/. It contains the fixed public training split,\nunlabeled validation inputs in validation_data/, a sample validation prediction\nfile and the unlabeled business prediction data. Inspect their actual schemas.\n<data_preview>```\ninput/\n    data/\n        validation_sample_predictions.csv (180 lines)\n        validation_schema.json (64 lines)\n        predict_data/\n            test.csv (419 lines)\n        train_data/\n   