, numpy as np, pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder\nfrom sklearn.impute import SimpleImputer, MissingIndicator\nfrom sklearn.linear_model import LogisticRegression\n\nseed = 42\nbase = "../input/data"\ntrain = pd.read_csv(f"{base}/train_data/train.csv")\ntest = pd.read_csv(f"{base}/predict_data/test.csv")\nos.makedirs("work", exist_ok=True)\n\n# --- schema / integrity checks ---\nprint("train shape", train.shape, "test shape", test.shape)\nprint("train cols", list(train.columns))\nprint("test cols", list(test.columns))\nassert train["PassengerId"].is_unique, "dup train id"\nassert test["PassengerId"].is_unique, "dup test id"\nassert set(train["Survived"].unique()) <= {0, 1}, "bad labels"\nprint("\\nNaN fraction (train):\\n", train.isna().mean().round(3))\nprint("\\nNaN fraction (test):\\n", test.isna().mean().round(3))\nprint("\\nSex train:", train["Sex"].value_counts().to_dict(), "test:", test["Sex"].value_counts().to_dict())\nprint("Embarked train:", train["Embarked"].value_counts(dropna=False).to_dict())\nprint("Embarked test:", test["Embarked"].value_counts(dropna=False).to_dict())\nprint("\\nAge range train:", train["Age"].min(), train["Age"].max(), "test:", test["Age"].min(), test["Age"].max())\nprint("Fare range train:", train["Fare"].min(), train["Fare"].max(), "test:", test["Fare"].min(), test["Fare"].max())\nprint("Survived dist:\\n", train["Survived"].value_counts(normalize=True).round(3))\n\n# --- fixed split (once) ---\nX = train.drop(columns=["Survived"])\ny = train["Survived"]\nX_tr, X_val, y_tr, y_val = train_test_split(\n    X, y, test_size=0.2, random_state=seed, stratify=y)\nval_ids = X_val["PassengerId"].tolist()\njson.dump(val_ids, open("work/val_ids.json", "w"))\nprint("\\nsplit sizes train/val:", len(X_tr), len(X_val))\n\n# --- preprocessing (fit on train rows only) ---\nnum_cols = ["Pclass", "SibSp", "Parch"]\nage_fare_features = ["Age", "Fare"]\ncat_cols = ["Sex", "Embarked"]\n\nage_fare_pipe = Pipeline([\n    ("imp", SimpleImputer(strategy="median", add_indicator=True)),\n])\nnum_pipe = Pipeline([\n    ("imp", SimpleImputer(strategy="median")),\n])\ncat_pipe = Pipeline([\n    ("imp", SimpleImputer(strategy="constant", fill_value="M")),\n    ("oh", OneHotEncoder(handle_unknown="ignore")),\n])\n\npre = ColumnTransformer([\n    ("num", num_pipe, num_cols),\n    ("af", age_fare_pipe, age_fare_features),\n    ("cat", cat_pipe, cat_cols),\n])\n\nclf = Pipeline([\n    ("pre", pre),\n    ("lr", LogisticRegression(max_iter=1000, random_state=seed)),\n])\nclf.fit(X_tr, y_tr)\n\n# --- validation ---\nval_prob = clf.predict_proba(X_val)[:, 1]\nval_pred = (val_prob >= 0.5).astype(int)\nval_acc = float((val_pred == y_val.values).mean())\nmaj_rate = float(y_val.value_counts(normalize=True).max())\nsex_rule = (X_val["Sex"] == "female").astype(int).values\nsex_acc = float((sex_rule == y_val.values).mean())\nprint(f"\\nVAL accuracy: {val_acc:.4f} | majority floor: {maj_rate:.4f} | sex-only floor: {sex_acc:.4f}")\n\nos.makedirs("work", exist_ok=True)\npd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(\n    "work/val_predictions.csv", index=False)\n\n# --- test predictions ---\ntest_prob = clf.predict_proba(test)[:, 1]\ntest_pred = (test_prob >= 0.5).astype(int)\npd.DataFrame({"PassengerId": test["PassengerId"].values,\n              "Survived": test_pred}).to_csv("predictions.csv", index=False)\n\n# --- artifacts ---\njson.dump({"val_accuracy": val_acc, "majority_baseline": maj_rate,\n           "sex_only_baseline": sex_acc, "model": "LogisticRegression baseline",\n           "seed": seed}, open("work/metrics.json", "w"), indent=2)\njoblib.dump(clf, "work/model_baseline.joblib")\nopen("work/README.txt", "w").write(\n    "Inference: load model_baseline.joblib; predict_proba[:,1] >= 0.5 -> 1.\\n"\n    "Preprocessing fitted on 712 train rows 