rn.impute", fromlist=["MissingIndicator"]).MissingIndicator(features="missing")),\n                      ("sc", StandardScaler())]), age_fare),\n    ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                      ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n])\n\nclf = Pipeline([\n    ("pre", pre),\n    ("lr", LogisticRegression(max_iter=1000, random_state=seed, n_jobs=1)),\n])\nclf.fit(X_tr, y_tr)\n\n# --- validation ---\nval_pred = (clf.predict_proba(X_val)[:, 1] >= 0.5).astype(int)\nval_acc = float((val_pred == y_val.values).mean())\nmaj_rate = float(y_val.value_counts(normalize=True).max())\nprint("val acc", val_acc, "majority", maj_rate)\n\npd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(\n    "work/val_predictions.csv", index=False)\n\n# --- test predictions ---\ntest_pred = (clf.predict_proba(test)[:, 1] >= 0.5).astype(int)\npd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred}).to_csv(\n    "work/predictions.csv", index=False)\n\n# --- artifacts ---\njson.dump({"val_accuracy": val_acc, "majority_baseline": maj_rate,\n           "model": "LogisticRegression baseline"},\n          open("work/metrics.json", "w"), indent=2)\njoblib.dump(clf, "work/model_baseline.joblib")\nopen("work/README.txt", "w").write(\n    "Inference: load model_baseline.joblib; predict_proba[:,1] >= 0.5 -> 1. "\n    "Preprocessing fitted on 712 train rows only.")\nprint(open("work/predictions.csv").readline(), len(test_pred))</code_outline>\n\nRead local data from ../input/data/. It contains the fixed public training split,\nunlabeled validation inputs in validation_data/, a sample validation prediction\nfile and the unlabeled business prediction data. Inspect their actual schemas.\n<data_preview>```\ninput/\n    data/\n        validation_sample_predictions.csv (180 lines)\n        validation_schema.json (64 lines)\n        predict_data/\n            test.csv (419 lines)\n        train_data/\n   