[2026-10-18 23:25:59,399 coder-round-001-experiment-01 INFO] Code iteration 1: Establish the baseline: load the actual local data, run data-quality checks, create the single fixed split (persist val_ids.json), fit a LogisticRegression with median-imputed Age/Fare + missing indicators, one-hot Sex/Embarked, and print validation accuracy. Expected runtime a few seconds. Tests the hypothesis that baseline validation accuracy lands ~0.780.82 above the majority and Sex-only floors. This cell writes both complete prediction outputs.
import os, json, joblib, numpy as np, pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer, MissingIndicator
from sklearn.linear_model import LogisticRegression

seed = 42
base = "../input/data"
train = pd.read_csv(f"{base}/train_data/train.csv")
test = pd.read_csv(f"{base}/predict_data/test.csv")
os.makedirs("work", exist_ok=True)

# --- schema / integrity checks ---
print("train shape", train.shape, "test shape", test.shape)
print("train cols", list(train.columns))
print("test cols", list(test.columns))
assert train["PassengerId"].is_unique, "dup train id"
assert test["PassengerId"].is_unique, "dup test id"
assert set(train["Survived"].unique()) <= {0, 1}, "bad labels"
print("\nNaN fraction (train):\n", train.isna().mean().round(3))
print("\nNaN fraction (test):\n", test.isna().mean().round(3))
print("\nSex train:", train["Sex"].value_counts().to_dict(), "test:", test["Sex"].value_counts().to_dict())
print("Embarked train:", train["Embarked"].value_counts(dropna=False).to_dict())
print("Embarked test:", test["Embarked"].value_counts(dropna=False).to_dict())
print("\nAge range train:", train["Age"].min(), train["Age"].max(), "test:", test["Age"].min(), test["Age"].max())
print("Fare range train:", train["Fare"].min(), train["Fare"].max(), "test:", test["Fare"].min(), test["Fare"].max())
print("Survived dist:\n", train["Survived"].value_counts(normalize=True).round(3))

# --- fixed split (once) ---
X = train.drop(columns=["Survived"])
y = train["Survived"]
X_tr, X_val, y_tr, y_val = train_test_split(
    X, y, test_size=0.2, random_state=seed, stratify=y)
val_ids = X_val["PassengerId"].tolist()
json.dump(val_ids, open("work/val_ids.json", "w"))
print("\nsplit sizes train/val:", len(X_tr), len(X_val))

# --- preprocessing (fit on train rows only) ---
num_cols = ["Pclass", "SibSp", "Parch"]
age_fare_features = ["Age", "Fare"]
cat_cols = ["Sex", "Embarked"]

age_fare_pipe = Pipeline([
    ("imp", SimpleImputer(strategy="median", add_indicator=True)),
])
num_pipe = Pipeline([
    ("imp", SimpleImputer(strategy="median")),
])
cat_pipe = Pipeline([
    ("imp", SimpleImputer(strategy="constant", fill_value="M")),
    ("oh", OneHotEncoder(handle_unknown="ignore")),
])

pre = ColumnTransformer([
    ("num", num_pipe, num_cols),
    ("af", age_fare_pipe, age_fare_features),
    ("cat", cat_pipe, cat_cols),
])

clf = Pipeline([
    ("pre", pre),
    ("lr", LogisticRegression(max_iter=1000, random_state=seed)),
])
clf.fit(X_tr, y_tr)

# --- validation ---
val_prob = clf.predict_proba(X_val)[:, 1]
val_pred = (val_prob >= 0.5).astype(int)
val_acc = float((val_pred == y_val.values).mean())
maj_rate = float(y_val.value_counts(normalize=True).max())
sex_rule = (X_val["Sex"] == "female").astype(int).values
sex_acc = float((sex_rule == y_val.values).mean())
print(f"\nVAL accuracy: {val_acc:.4f} | majority floor: {maj_rate:.4f} | sex-only floor: {sex_acc:.4f}")

os.makedirs("work", exist_ok=True)
pd.DataFrame({"PassengerId": val_ids, "Survived": val_pred}).to_csv(
    "work/val_predictions.csv", index=False)

# --- test predictions ---
test_prob = clf.predict_proba(test)[:, 1]
test_pred = (test_prob >= 0.5).astype(int)
pd.DataFrame({"PassengerId": test["PassengerId"].values,
              "Survived": test_pred}).to_csv("predictions.csv", index=False)

# --- artifacts ---
json.dump({"val_accuracy": val_acc, "majority_baseline": maj_rate,
           "sex_only_baseline": sex_acc, "model": "LogisticRegression baseline",
           "seed": seed}, open("work/metrics.json", "w"), indent=2)
joblib.dump(clf, "work/model_baseline.joblib")
open("work/README.txt", "w").write(
    "Inference: load model_baseline.joblib; predict_proba[:,1] >= 0.5 -> 1.\n"
    "Preprocessing fitted on 712 train rows only. Sex/Embarked one-hot "
    "(Embarked missing->'M'); Age/Fare median-imputed with missing indicators; "
    "Pclass/SibSp/Parch numeric. CPU only, seed 42.")

# --- alignment checks on outputs ---
vp = pd.read_csv("work/val_predictions.csv")
pp = pd.read_csv("predictions.csv")
assert vp["PassengerId"].tolist() == val_ids
assert len(pp) == len(test) == 418 and list(pp.columns) == ["PassengerId", "Survived"]
assert pp["PassengerId"].tolist() == test["PassengerId"].tolist()
assert set(pp["Survived"].unique()) <= {0, 1}
print("predictions.csv rows:", len(pp), "val rows:", len(vp), "positive rate test:", pp["Survived"].mean().round(3))
