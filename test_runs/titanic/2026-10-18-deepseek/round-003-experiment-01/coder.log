rskf = RepeatedStratifiedKFold(n_splits=5, n_repeats=2, random_state=SEED)
def cv_acc(title_age):
    scores=[]
    for trk, vak in rskf.split(np.zeros(len(tr_full)), tr_full["Survived"].values):
        d_tr = tr_full.iloc[trk].reset_index(drop=True)
        d_va = tr_full.iloc[vak].reset_index(drop=True)
        m = Blend(title_age=title_age).fit(d_tr, d_tr["Survived"])
        scores.append((m.predict(d_va)==d_va["Survived"].astype(int).values).mean())
    return float(np.mean(scores))

