import os, json, hashlib, joblib, warnings
import numpy as np, pandas as pd
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import ExtraTreesClassifier
from sklearn.model_selection import StratifiedKFold, cross_val_score
from sklearn.base import BaseEstimator, ClassifierMixin, clone
warnings.filterwarnings("ignore")

SEED = 42
WARD = "work"; os.makedirs(WARD, exist_ok=True)
base = "../input/data"
train = pd.read_csv(f"{base}/train_data/train.csv")
val   = pd.read_csv(f"{base}/validation_data/validation.csv")
test  = pd.read_csv(f"{base}/predict_data/test.csv")
assert len(train) == 712 and len(val) == 179 and len(test) == 418

val_ids_path = f"{WARD}/val_ids.json"
val_ids = val["PassengerId"].tolist()
if os.path.exists(val_ids_path):
    assert json.load(open(val_ids_path)) == val_ids, "val IDs changed"
else:
    json.dump(val_ids, open(val_ids_path, "w"))
assert not set(train["PassengerId"]) & set(val["PassengerId"])
assert not set(train["PassengerId"]) & set(test["PassengerId"])
assert not set(val["PassengerId"]) & set(test["PassengerId"])

# ---- featurize variants ----
def featurize(df, use_inter):
    d = df.copy()
    d["FamilySize"] = d["SibSp"] + d["Parch"] + 1
    d["IsAlone"]    = (d["FamilySize"] == 1).astype(int)
    t = d["Name"].str.extract(r",\s*([^.]+)\.", expand=False)
    t = t.replace({"Mlle": "Miss", "Ms": "Miss", "Mme": "Mrs"}).fillna("Rare")
    d["Embarked"] = d["Embarked"].fillna("M")
    d["_Title"] = t
    if use_inter:
        # Sex x Pclass interactions as categorical strings
        d["SexPclass"] = d["Sex"].astype(str) + "_" + d["Pclass"].astype(str)
        # FareBand via quantile-ish thresholds (fixed, not label-based)
        fb = pd.cut(d["Fare"], bins=[-1, 7.9, 14.5, 31, 1000], labels=["lo","mid","hi","vh"])
        d["FareBand"] = fb.astype(str)
    return d

num_base = ["Pclass","SibSp","Parch","FamilySize","IsAlone"]
af_cols  = ["Age","Fare"]
cat_base = ["Sex","Embarked","Title"]

def build_pre(cat_cols):
    return ColumnTransformer([
        ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_base),
        ("af",  Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),
        ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),
                          ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),
    ])

class Blend(BaseEstimator, ClassifierMixin):
    def __init__(self, use_inter=False, w=0.5, depth=6, leaf=4):
        self.use_inter=use_inter; self.w=w; self.depth=depth; self.leaf=leaf
    def _cols(self):
        cats = cat_base + (["SexPclass","FareBand"] if self.use_inter else [])
        return num_base + af_cols + cats, cats
    def fit(self, df, y=None):
        cols, cats = self._cols(); y = df["Survived"].astype(int).values; X = df[cols]
        self.lr_ = Pipeline([("pre", build_pre(cats)),("lr",LogisticRegression(max_iter=2000,random_state=SEED))]).fit(X,y)
        self.et_ = Pipeline([("pre", build_pre(cats)),("et",ExtraTreesClassifier(
            n_estimators=400,max_depth=self.depth,min_samples_leaf=self.leaf,criterion="gini",
            random_state=SEED,n_jobs=4))]).fit(X,y)
        self.cols_=cols; return self
    def predict_proba(self, df):
        X=df[self.cols_]
        p=self.w*self.lr_.predict_proba(X)[:,1]+(1-self.w)*self.et_.predict_proba(X)[:,1]
        return np.vstack([1-p,p]).T
    def predict(self, df): return (self.predict_proba(df)[:,1]>=0.5).astype(int)

def apply_rare(tr_df, dfs, rare_set):
    out=[]
    for d in [tr_df]+dfs:
        d=d.copy(); d["Title"]=d["_Title"].where(~d["_Title"].isin(rare_set),"Rare"); out.append(d)
    return out

# rare map from FULL training (all CV folds share the same map -> mild but standard)
tr0 = featurize(train, True)
tc = tr0["_Title"].value_counts(); rare = tc[tc<10].index
tr_full_i = featurize(train, True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))
val_i     = featurize(val,  True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))
te_i      = featurize(test, True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))
# non-inter versions just drop the extra cols at fit-time via use_inter flag

# ---- 5-fold CV on 712 rows: compare candidates by CV accuracy ----
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
def cv_acc(params):
    model = Blend(**params)
    # cross_val_score needs arrays; we pass the df via index slicing
    scores=[]
    for trk, vak in skf.split(np.zeros(len(tr_full_i)), tr_full_i["Survived"].values):
        d_tr = tr_full_i.iloc[trk].reset_index(drop=True)
        d_va = tr_full_i.iloc[vak].reset_index(drop=True)
        m = Blend(**params).fit(d_tr, d_tr["Survived"])
        scores.append((m.predict(d_va)==d_va["Survived"].astype(int).values).mean())
    return float(np.mean(scores))

candidates = {
    "incumbent":      dict(use_inter=False, w=0.5, depth=6, leaf=4),
