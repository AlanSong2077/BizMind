best_C, best_cv = 1.0, -1
for C in [0.03, 0.1, 0.3, 1.0, 3.0, 10.0]:
    s = cross_val_score(make_pipeline(C), X_tr, y_tr, cv=cv,
                        scoring="accuracy", n_jobs=1).mean()
    print(f"C={C:<5} cv_acc={s:.4f}")
    if s > best_cv:
        best_cv, best_C = s, C
