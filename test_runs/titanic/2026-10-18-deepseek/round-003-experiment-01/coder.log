tc = tr0["_Title"].value_counts(); rare = list(tc[tc < 10].index)
def set_title(d):
    d = d.copy(); d["Title"] = d["_Title"].where(~d["_Title"].isin(rare), "Rare"); return d
tr_full = set_title(tr0)
val_f   = set_title(base_feat(val))
te_f    = set_title(base_feat(test))

# Title-conditioned median age map from FULL train (used only by title-age variant)
title_age_med = tr_full.groupby("Title")["Age"].median().to_dict()
global_age    = train["Age"].median()
def fill_age_title(d):
    d = d.copy()
    med = d["Title"].map(title_age_med).fillna(global_age)
    d["Age"] = d["Age"].fillna(med)
    return d

num_cols = ["Pclass","SibSp","Parch","FamilySize","IsAlone"]
af_cols  = ["Age","Fare"]
cat_cols = ["Sex","Embarked","Title"]

class Blend(BaseEstimator, ClassifierMixin):
    def __init__(self, title_age=False, w=0.5, depth=6, leaf=4):
        self.title_age=title_age; self.w=w; self.depth=depth; self.leaf=leaf
    def _prep(self, df):
        if self.title_age: return fill_age_title(df)
        return df
    def _pre(self):
        return ColumnTransformer([
            ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_cols),
            ("af",  Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),
            ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),
                              ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),
        ])
    def fit(self, df, y=None):
        d = self._prep(df); y = d["Survived"].astype(int).values; X = d[num_cols+af_cols+cat_cols]
        self.lr_ = Pipeline([("pre", self._pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X,y)
        self.et_ = Pipeline([("pre", self._pre()), ("et", ExtraTreesClassifier(
            n_estimators=400, max_depth=self.depth, min_samples_leaf=self.leaf, criterion="gini",
            random_state=SEED, n_jobs=4))]).fit(X,y)
        return self
    def predict(self, df):
        d = self._prep(df); X = d[num_cols+af_cols+cat_cols]
        p = self.w*self.lr_.predict_proba(X)[:,1] + (1-self.w)*self.et_.predict_proba(X)[:,1]
        return (p>=0.5).astype(int)

