]).fit(X,y)\n    return lr, et\ndef blend_prob(lr, et, df):\n    Xf = df[cols]\n    return 0.5*lr.predict_proba(Xf)[:,1] + 0.5*et.predict_proba(Xf)[:,1]\n\n# ---- repeated CV: collect out-of-fold probabilities once ----\nrskf = RepeatedStratifiedKFold(n_splits=5, n_repeats=2, random_state=SEED)\noof_p, oof_y = [], []\nfor trk, vak in rskf.split(np.zeros(len(tr_full)), tr_full["Survived"].values):\n    d_tr = tr_full.iloc[trk].reset_index(drop=True)\n    d_va = tr_full.iloc[vak].reset_index(drop=True)\n    lr, et = fit_blend(d_tr)\n    oof_p.append(blend_prob(lr, et, d_va))\n    oof_y.append(d_va["Survived"].astype(int).values)\noof_p = np.concatenate(oof_p); oof_y = np.concatenate(oof_y)\n\nthrs = np.round(np.arange(0.40, 0.61, 0.02), 2)\nacc_by_thr = {float(t): float(((oof_p >= t).astype(int) == oof_y).mean()) for t in thrs}\nacc_05 = acc_by_thr[0.5]\nbest_thr = max(acc_by_thr, key=acc_by_thr.get)\nACCEPT = (acc_by_thr[best_thr] - acc_05) > 0.004 and best_thr != 0.5\nTHR = best_thr if ACCEPT else 0.5\n\n# ---- fit final model on FULL 712, apply chosen threshold ----\nlr_f, et_f = fit_blend(tr_full)\nval_pred  = (blend_prob(lr_f, et_f, val_f) >= THR).astype(int)\ntest_pred = (blend_prob(lr_f, et_f, te_f)  >= THR).astype(int)\n\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred.astype(int)})\npp.to_csv("predictions.csv", index=False)\nvp = pd.DataFrame({"PassengerId": val["PassengerId"].values, "Survived": val_pred.astype(int)})\nvp.to_csv(f"{WARD}/val_predictions.csv", index=False)\n\njoblib.dump({"lr": lr_f, "et": et_f, "w": 0.5, "threshold": THR,\n             "cols": cols, "title_rare": rare}, f"{WARD}/model_best.joblib")\n\n# ---- ledger ----\ncomp_path = f"{WARD}/comparison.csv"\nrows = [{"round":"threshold_cv","variant":f"thr={thr:.2f}","holdout_acc":round(a,4),\n         "accepted":(thr==THR and abs(thr-THR)<1e-9)} for thr, a in acc_by_thr.items()]\nif os.path.exists(comp_path):\n    cmp = pd.read_csv(comp_path)\n    for r in