cmp = cmp[cmp["variant"] != r["variant"]]\n    cmp = pd.concat([cmp, pd.DataFrame(rows)], ignore_index=True)\nelse:\n    cmp = pd.DataFrame(rows)\ncmp.to_csv(comp_path, index=False)\n\nmetrics = {\n    "seed": SEED, "round": "cv5_select",\n    "selection": "5-fold stratified CV on 712 labeled rows (rs=42)",\n    "cv_scores": cv_scores, "incumbent_cv": inc_cv,\n    "chosen": CHOSEN, "chosen_params": chosen_params,\n    "accepted_over_incumbent": ACCEPT,\n    "external_incumbent_reference_acc": 0.8492,\n    "md5_val": hashlib.md5(open(f"{WARD}/val_predictions.csv","rb").read()).hexdigest()[:10],\n    "md5_test": hashlib.md5(open("predictions.csv","rb").read()).hexdigest()[:10],\n}\njson.dump(metrics, open(f"{WARD}/metrics.json","w"), indent=2)\n\nopen(f"{WARD}/README.txt","w").write(\n    f"ROUND cv5_select: 5-fold CV selection on 712 train rows.\\n"\n    f"CV scores: {cv_scores}\\nChosen: {CHOSEN} params={chosen_params} accepted={ACCEPT}\\n"\n    "Model: prob=w*p_LR+(1-w)*p_ET, Survived=1 if prob>=0.5. Seed 42, CPU n_jobs=4.\\n"\n    "Inference: featurize (Title rare-map, FamilySize, IsAlone, Embarked->M"\n    + (", SexPclass, FareBand" if chosen_params["use_inter"] else "") + ") then predict.\\n")\n\n# ---- assertions ----\nassert list(pp.columns)==["PassengerId","Survived"] and len(pp)==418\nassert pp["PassengerId"].tolist()==test["PassengerId"].tolist()\nassert list(vp.columns)==["PassengerId","Survived"] and len(vp)==179\nassert vp["PassengerId"].tolist()==val_ids\nassert set(pp["Survived"].unique())<={0,1} and set(vp["Survived"].unique())<={0,1}\n\nloaded = joblib.load(f"{WARD}/model_best.joblib")["model"]\nassert (loaded.predict(val_i)==vp["Survived"].values).all(), "val drift"\nassert (loaded.predict(te_i)==pp["Survived"].values).all(), "test drift"\n\nprint("CV scores:", cv_scores)\nprint("Chosen: %s (params=%s, accepted=%s)" % (CHOSEN, chosen_params, ACCEPT))\nprint("test pos rate %.3f | val pos rate %.3f" % (pp["Survived"].mean(), vp["Survived"].mean()))\np