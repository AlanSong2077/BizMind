"PassengerId"]) & set(test["PassengerId"])\nassert not set(val["PassengerId"]) & set(test["PassengerId"])\n\n# ---- common featurize (rare map from FULL train; title-based imputation applied per variant) ----\ndef base_feat(df):\n    d = df.copy()\n    d["FamilySize"] = d["SibSp"] + d["Parch"] + 1\n    d["IsAlone"]    = (d["FamilySize"] == 1).astype(int)\n    t = d["Name"].str.extract(r",\\s*([^.]+)\\.", expand=False)\n    t = t.replace({"Mlle":"Miss","Ms":"Miss","Mme":"Mrs"}).fillna("Rare")\n    d["Embarked"] = d["Embarked"].fillna("M")\n    d["_Title"] = t\n    return d\n\ntr0 = base_feat(train)\ntc = tr0["_Title"].value_counts(); rare = list(tc[tc < 10].index)\ndef set_title(d):\n    d = d.copy(); d["Title"] = d["_Title"].where(~d["_Title"].isin(rare), "Rare"); return d\ntr_full = set_title(tr0)\nval_f   = set_title(base_feat(val))\nte_f    = set_title(base_feat(test))\n\n# Title-conditioned median age map from FULL train (used only by title-age variant)\ntitle_age_med = tr_full.groupby("Title")["Age"].median().to_dict()\nglobal_age    = train["Age"].median()\ndef fill_age_title(d):\n    d = d.copy()\n    med = d["Title"].map(title_age_med).fillna(global_age)\n    d["Age"] = d["Age"].fillna(med)\n    return d\n\nnum_cols = ["Pclass","SibSp","Parch","FamilySize","IsAlone"]\naf_cols  = ["Age","Fare"]\ncat_cols = ["Sex","Embarked","Title"]\n\nclass Blend(BaseEstimator, ClassifierMixin):\n    def __init__(self, title_age=False, w=0.5, depth=6, leaf=4):\n        self.title_age=title_age; self.w=w; self.depth=depth; self.leaf=leaf\n    def _prep(self, df):\n        if self.title_age: return fill_age_title(df)\n        return df\n    def _pre(self):\n        return ColumnTransformer([\n            ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_cols),\n            ("af",  Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),\n            ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                              ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n        ])\n    def fit(self, df, y=None):\n        d = self._prep(df); y = d["Survived"].astype(int).values; X = d[num_cols+af_cols+cat_cols]\n        self.lr_ = Pipeline([("pre", self._pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X,y)\n        self.et_ = Pipeline([("pre", self._pre()), ("et", ExtraTreesClassifier(\n            n_estimators=400, max_depth=self.depth, min_samples_leaf=self.leaf, criterion="gini",\n            random_state=SEED, n_jobs=4))]).fit(X,y)\n        return self\n    def predict(self, df):\n        d = self._prep(df); X = d[num_cols+af_cols+cat_cols]\n        p = self.w*self.lr_.predict_proba(X)[:,1] + (1-self.w)*self.et_.predict_proba(X)[:,1]\n        return (p>=0.5).astype(int)\n\n# ---- repeated stratified CV comparison on 712 rows ----\nrskf = RepeatedStratifiedKFold(n_splits=5, n_repeats=2, random_state=SEED)\ndef cv_acc(title_age):\n    scores=[]\n    for trk, vak in rskf.split(np.zeros(len(tr_full)), tr_full["Survived"].values):\n        d_tr = tr_full.iloc[trk].reset_index(drop=True)\n        d_va = tr_full.iloc[vak].reset_index(drop=True)\n        m = Blend(title_age=title_age).fit(d_tr, d_tr["Survived"])\n        scores.append((m.predict(d_va)==d_va["Survived"].astype(int).values).mean())\n    return float(np.mean(scores))\n\ncv_inc = cv_acc(False)\ncv_ta  = cv_acc(True)\nACCEPT = (cv_ta - cv_inc) > 0.004\nCHOSEN_TA = bool(ACCEPT)\n\n# ---- retrain chosen on FULL 712 rows ----\nmodel = Blend(title_age=CHOSEN_TA).fit(tr_full, tr_full["Survived"])\nval_pred  = model.predict(val_f)\ntest_pred = model.predict(te_f)\n\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred.astype(int)})\npp.to_csv("predictions.csv", index=False)\nvp = pd.DataFrame({"PassengerId": val["PassengerId"].values, "Survived": val_pred.astype(int)})\nvp.to_csv(f"{WARD}/val_predictions.csv", index=False)\n\njoblib.dump({"model": model, "title_age": CHOSEN_TA, "title_age_med": title_age_med,\n             "global_age": global_age, "rare": rare, "threshold": 0.5,\n             "cols": num_cols+af_cols+cat_cols}, f"{WARD}/model_best.joblib")\n\n# ---- ledger ----\ncomp_path = f"{WARD}/comparison.csv"\nrows = [{"round":"title_age_cv","variant":"incumbent","holdout_acc":round(cv_inc,4),"accepted":(not CHOSEN_TA)},\n        {"round":"title_age_cv","variant":"title_age_impute","holdout_acc":round(cv_ta,4),"accepted":CHOSEN_TA}]\nif os.path.exists(comp_path):\n    cmp = pd.read_csv(comp_path)\n    for r in rows: cmp = cmp[cmp["variant"] != r["variant"]]\n    cmp = pd.concat([cmp, pd.DataFrame(rows)], ignore_index=True)\nelse:\n    cmp = pd.DataFrame(rows)\ncmp.to_csv(comp_path, index=False)\n\nmetrics = {\n    "seed": SEED, "round": "title_age_cv",\n    "selection": "2x5 repeated stratified CV on 712 rows",\n    "cv_incumbent": round(cv_inc,4), "cv_title_age": round(cv_ta,4),\n    "accepted_title_age": CHOSEN_TA, "margin_required": 0.004,\n    "chosen": "title_age" if CHOSEN_TA else "incumbent",\n    "external_incumbent_reference_acc": 0.8492,\n    "md5_val": hashlib.md5(open(f"{WARD}/val_predictions.csv","rb").read()).hexdigest()[:10],\n    "md5_test": hashlib.md5(open("predictions.csv","rb").read()).hexdigest()[:10],\n}\njson.dump(metrics, open(f"{WARD}/metrics.json","w"), indent=2)\n\nopen(f"{WARD}/README.txt","w").write(\n    "ROUND title_age_cv: tested Age imputation by Title-conditioned median.\\n"\n    f"CV incumbent={cv_inc:.4f}, title_age={cv_ta:.4f}, chosen={\'title_age\' if CHOSEN_TA else \'incumbent\'}\\n"\n    f"title_age_med={title_age_med}, global_age={global_age}\\n"\n    "Model: prob=w*p_LR+(1-w)*p_ET with w=0.5; Survived=1 if prob>=0.5. Seed 42, CPU n_jobs=4.\\n"\n    "Inference: featurize (FamilySize,IsAlone,Title rare-map,Embarked NA->M"\n    + (", Age NA->Title-median" if CHOSEN_TA else "") + "); OHE cat; predict.\\n")\n\n# ---- assertions ----\nassert list(pp.columns)==["PassengerId","Survived"] and len(pp)==418\nassert pp["PassengerId"].tolist()==test["PassengerId"].tolist()\nassert list(vp.columns)==["PassengerId","Survived"] and len(vp)==179\nassert vp["PassengerId"].tolist()==val_ids\nassert set(pp["Survived"].unique())<={0,1} and set(vp["Survived"].unique())<={0,1}\n\nloaded = joblib.load(f"{WARD}/model_best.joblib")["model"]\nassert (loaded.predict(val_f)==vp["Survived"].values).all(), "val drift"\nassert (loaded.predict(te_f)==pp["Survived"].values).all(), "test drift"\n\nprint("CV: incumbent=%.4f title_age=%.4f chosen=%s" % (cv_inc, cv_ta, metrics["chosen"]))\nprint("test pos rate %.3f | val pos rate %.3f" % (pp["Survived"].mean(), vp["Survived"].mean()))\nprint("Reproducibility OK.")\n</code>\n<validation_prediction_file>work/val_predictions.csv</validation_prediction_file>\n<prediction_file>predictions.csv</prediction_file>'}, {'role': 'user', 'content': 'Execution time: 3.73 seconds; success: True.\n<output>CV: incumbent=0.8244 title_age=0.8252 chosen=incumbent\ntest pos rate 0.383 | val pos rate 0.346\nReproducibility OK.</output>\n<error></error>\nUse this evidence to repair failures or test the next controlled improvement.\n\nMeasured fixed-split validation metric: Metric↑(0.8492). Best so far: Metric↑(0.8492).\n\nRespond with exactly one executable notebook cell, using these tags:\n<goal>Hypothesis, expected runtime, expected output and how it tests the hypothesis</goal>\n<code>Python code for the next cell, without Markdown fences</code>\n<validation_prediction_file>Relative file path for complete validation predictions, or None</validation_prediction_file>\n<prediction_file>Relative file path for complete business prediction output, or None</prediction_file>\nBoth file tags must be None unless this cell writes BOTH complete outputs.\nDo not report an estimated score: the independent local evaluator measures it.\n'}, {'role': 'assistant', 'content': '<goal>The