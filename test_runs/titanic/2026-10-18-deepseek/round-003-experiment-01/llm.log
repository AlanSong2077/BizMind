pleImputer(strategy="constant", fill_value="M")),\n                          ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n    ])\n\ny = tr_f["Survived"].values\nX = tr_f[num_cols + af_cols + cat_cols]\n\n# ---- INCUMBENT model (unchanged) ----\nBW, BD, BL, BN = 0.5, 6, 4, 400\nlr_final = Pipeline([("pre", make_pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X, y)\net_final = Pipeline([("pre", make_pre()), ("et", ExtraTreesClassifier(\n    n_estimators=BN, max_depth=BD, min_samples_leaf=BL,\n    random_state=SEED, n_jobs=4))]).fit(X, y)\n\nXv = val_f[num_cols + af_cols + cat_cols]\nXt = te_f[num_cols + af_cols + cat_cols]\ndef blend(Xf):\n    return BW * lr_final.predict_proba(Xf)[:, 1] + (1 - BW) * et_final.predict_proba(Xf)[:, 1]\n\n# ---- single controlled change: decision threshold ----\nTHR = 0.45\nval_prob  = blend(Xv)\ntest_prob = blend(Xt)\nval_pred  = (val_prob  >= THR).astype(int)\ntest_pred = (test_prob >= THR).astype(int)\n\n# report how many rows differ from threshold 0.5 (diagnostic; no labels used)\nval_flip = int(((val_prob >= 0.5).astype(int) != val_pred).sum())\ntest_flip = int(((test_prob >= 0.5).astype(int) != test_pred).sum())\n\npd.DataFrame({"PassengerId": val["PassengerId"], "Survived": val_pred}).to_csv(f"{WARD}/val_predictions.csv", index=False)\npp = pd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred})\npp.to_csv("predictions.csv", index=False)\n\nmetrics = {\n    "seed": SEED, "round": 12,\n    "change": "decision threshold 0.5 -> 0.45 on the incumbent blend (model unchanged)",\n    "chosen": {"w": BW, "depth": BD, "leaf": BL, "n_estimators": BN, "threshold": THR},\n    "incumbent_fixed_val_accuracy": 0.8492,\n    "val_flips_vs_0.5": val_flip, "test_flips_vs_0.5": test_flip,\n    "history": {"r4_cv_tuned": 0.8436, "r5_r7_r9_incumbent": 0.8492, "r6_interactions": 0.8212,\n                "r8_lr_et_gb": 0.8436, "r10_more_trees": 0.8436},\n    "note": "prob>=threshold -> 1; both