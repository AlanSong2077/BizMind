ork/model_best.joblib.\\n"\n    "Negative evidence: deck, add_GB, interactions, w40(0.8436), title_age, thr0.58(0.8268) all < 0.8492.\\n")\n\nassert list(pp.columns)==["PassengerId","Survived"] and len(pp)==418\nassert pp["PassengerId"].tolist()==test["PassengerId"].tolist()\nassert list(vp.columns)==["PassengerId","Survived"] and len(vp)==179\nassert vp["PassengerId"].tolist()==val_ids\nassert set(pp["Survived"].unique())<={0,1} and set(vp["Survived"].unique())<={0,1}\nloaded = joblib.load(f"{WARD}/model_best.joblib")\ndef _pred(m, df):\n    Xf=df[cols]; p=m["w"]*m["lr"].predict_proba(Xf)[:,1]+(1-m["w"])*m["et"].predict_proba(Xf)[:,1]\n    return (p >= m["threshold"]).astype(int)\nassert (_pred(loaded, val_f)==vp["Survived"].values).all()\nassert (_pred(loaded, te_f)==pp["Survived"].values).all()\n\nprint("FINAL incumbent w=%.1f depth=%d leaf=%d thr=%.1f (external 0.8492)" % (BW,BD,BL,THR))\nprint("predictions.csv=%d, work/val_predictions.csv=%d. Reproducibility OK." % (len(pp), len(vp)))\n</code>\n<validation_prediction_file>work/val_predictions.csv</validation_prediction_file>\n<prediction_file>predictions.csv</prediction_file>', role='assistant', tool_calls=None, function_call=None, provider_specific_fields=None), provider_specific_fields={})], usage=Usage(completion_tokens=2128, prompt_tokens=56469, total_tokens=58597, completion_tokens_details=None, prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=None, cache_write_tokens=None, cached_tokens=56192, image_tokens=None, text_tokens=None), prompt_cache_hit_tokens=56192, prompt_cache_miss_tokens=277))
