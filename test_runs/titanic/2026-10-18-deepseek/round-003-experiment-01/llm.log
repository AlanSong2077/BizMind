pleImputer(strategy="constant", fill_value="M")),\n                          ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n    ])\n\ny = tr_f["Survived"].values\nX = tr_f[num_cols + af_cols + cat_cols]\n\n# ---- INCUMBENT model (unchanged) ----\nBW, BD, BL, BN = 0.5, 6, 4, 400\nlr_final = Pipeline([("pre", make_pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X, y)\net_final = Pipeline([("pre", make_pre()), ("et", ExtraTreesClassifier(\n    n_estimators=BN, max_depth=BD, min_samples_leaf=BL,\n    random_state=SEED, n_jobs=4))]).fit(X, y)\n\nXv = val_f[num_cols + af_cols + cat_cols]\nXt = te_f[num_cols + af_cols + cat_cols]\ndef blend(Xf):\n    return BW * lr_final.predict_proba(Xf)[:, 1] + (1 - BW) * et_final.predict_proba(Xf)[:, 1]\n\n# ---- single controlled change: decision threshold ----\nTHR = 0.45\nval_prob  = blend(Xv)\ntest_prob = blend(Xt)\nval_pred  = (val_prob  >= THR).astype(int)\ntest_pred = (test_prob >= THR).astype(int)\n\n# report how many rows differ from threshold 0.5 (diagnostic; no labels used)\nval_flip = int(((val_prob >= 0.5).astype(int) != val_pred).sum())\ntest_flip = int(((test_prob >= 0.5).astype(int) != test_pred).sum())\n\npd.DataFrame({"PassengerId": val["PassengerId"], "Survived": val_pred}).to_csv(f"{WARD}/val_predictions.csv", index=False)\npp = pd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred})\npp.to_csv("predictions.csv", index=False)\n\nmetrics = {\n    "seed": SEED, "round": 12,\n    "change": "decision threshold 0.5 -> 0.45 on the incumbent blend (model unchanged)",\n    "chosen": {"w": BW, "depth": BD, "leaf": BL, "n_estimators": BN, "threshold": THR},\n    "incumbent_fixed_val_accuracy": 0.8492,\n    "val_flips_vs_0.5": val_flip, "test_flips_vs_0.5": test_flip,\n    "history": {"r4_cv_tuned": 0.8436, "r5_r7_r9_incumbent": 0.8492, "r6_interactions": 0.8212,\n                "r8_lr_et_gb": 0.8436, "r10_more_trees": 0.8436},\n    "note": "prob>=threshold -> 1; both val/test predictions from same model; fixed-val acc scored by evaluator",\n}\njson.dump(metrics, open(f"{WARD}/metrics.json", "w"), indent=2)\njoblib.dump({"lr": lr_final, "et": et_final, "w": BW, "n_estimators": BN, "threshold": THR},\n            f"{WARD}/model_blend_best.joblib")\n\nopen(f"{WARD}/README.txt", "w").write(\n    "ROUND 12 - incumbent model with decision threshold 0.45 (from 0.5)\\n"\n    f"Config: w={BW}, ET n_estimators={BN}, max_depth={BD}, min_samples_leaf={BL}; threshold={THR}.\\n"\n    "Features: num[Pclass,SibSp,Parch,FamilySize,IsAlone]; af[Age(median+indicator,scaled),Fare]; "\n    "cat[Sex,Embarked(missing->\'M\'),Title (Mlle/Ms->Miss, Mme->Mrs, rare count<10->Rare)].\\n"\n    "Inference: prob = 0.5*p_LR + 0.5*p_ET; Survived=1 if prob>=0.45 else 0.\\n"\n    "Fit on all 712 train_data/train.csv rows; validation/test transform-only. Seed 42, CPU only.\\n"\n    "Baseline to beat: incumbent threshold-0.5 at 0.8492. Revert to 0.5 if this does not improve.\\n"\n    "Deliverables: predictions.csv (418 rows), work/val_predictions.csv (179 rows) from same model.\\n")\n\nvp = pd.read_csv(f"{WARD}/val_predictions.csv")\nassert list(vp.columns) == ["PassengerId", "Survived"] and len(vp) == 179\nassert vp["PassengerId"].tolist() == val_ids\nassert list(pp.columns) == ["PassengerId", "Survived"] and len(pp) == 418\nassert pp["PassengerId"].tolist() == test["PassengerId"].tolist()\nassert set(vp["Survived"].unique()) <= {0, 1} and set(pp["Survived"].unique()) <= {0, 1}\n\nloaded = joblib.load(f"{WARD}/model_blend_best.joblib")\ndef _blend(o, Xf):\n    return o["w"]*o["lr"].predict_proba(Xf)[:,1] + (1-o["w"])*o["et"].predict_proba(Xf)[:,1]\n_va = (_blend(loaded, Xv) >= loaded["threshold"]).astype(int)\n_te = (_blend(loaded, Xt) >= loaded["threshold"]).astype(int)\nassert (_va == vp["Survived"].values).all(), "val drift"\nassert (_te == pp["Survived"].values).all(), "test drift"\n\nprint("Round-12: incumbent model, threshold=%.2f (val flips vs 0.5=%d, test