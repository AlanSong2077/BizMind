_pre()), ("et", ExtraTreesClassifier(\n            n_estimators=400, max_depth=6, min_samples_leaf=4, criterion="gini",\n            random_state=SEED, n_jobs=4))]).fit(X, y)\n    gb = Pipeline([("pre", make_pre()), ("gb", GradientBoostingClassifier(\n            n_estimators=200, max_depth=3, learning_rate=0.05, subsample=0.9,\n            random_state=SEED))]).fit(X, y)\n    return lr, et, gb\n\ndef prob(lr, et, gb, df, weights):\n    Xf = df[cols]\n    ps = [lr.predict_proba(Xf)[:,1], et.predict_proba(Xf)[:,1], gb.predict_proba(Xf)[:,1]]\n    return sum(w*p for w,p in zip(weights, ps))\n\ndef lab(p, thr=0.5): return (p >= thr).astype(int)\n\n# ---- internal stratified holdout from 712 rows ----\ntr_idx, ih_idx = train_test_split(np.arange(len(tr_full)), test_size=0.2,\n                                  random_state=SEED, stratify=tr_full["Survived"].values)\ntr_sub = tr_full.iloc[tr_idx].reset_index(drop=True)\nih_sub = tr_full.iloc[ih_idx].reset_index(drop=True)\ny_ih   = ih_sub["Survived"].astype(int).values\n\nlr_s, et_s, gb_s = fit_members(tr_sub)\ninc_p   = prob(lr_s, et_s, gb_s, ih_sub, [0.5, 0.5, 0.0])\ninc_acc = accuracy_score(y_ih, lab(inc_p))\n\n# candidate blends (weights sum to 1)\ncandidates = {\n    "incumbent":     [0.5, 0.5, 0.0],\n    "add_gb_w20":    [0.4, 0.4, 0.2],\n    "add_gb_w30":    [0.35,0.35,0.30],\n    "add_gb_w15":    [0.425,0.425,0.15],\n}\nih_scores = {name: accuracy_score(y_ih, lab(prob(lr_s, et_s, gb_s, ih_sub, w)))\n             for name, w in candidates.items()}\n\nbest = max(ih_scores, key=ih_scores.get)\nACCEPT = ih_scores[best] > inc_acc + 1e-9 and best != "incumbent"\nCHOSEN = best if ACCEPT else "incumbent"\nbest_w = candidates[CHOSEN]\n\n# ---- retrain chosen config on FULL 712 rows ----\nlr_c, et_c, gb_c = fit_members(tr_full)\nval_pred  = lab(prob(lr_c, et_c, gb_c, val_f, best_w))\ntest_pred = lab(prob(lr_c, et_c, gb_c, te_f,  best_w))\n\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred.