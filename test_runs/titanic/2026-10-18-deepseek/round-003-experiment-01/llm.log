 or None</prediction_file>\nBoth file tags must be None unless this cell writes BOTH complete outputs.\nDo not report an estimated score: the independent local evaluator measures it.\n'}, {'role': 'assistant', 'content': '<goal>One unexplored structural hypothesis that is genuinely different from prior tweaks: the incumbent optimizes a single global threshold (0.5) on a blended probability. For imbalanced survival (~38%), a threshold shift to the class-prior-matched decision (predict 1 when p ≥ base positive rate) can raise accuracy if the model is well-calibrated. I test threshold tuning via robust 2×5 repeated stratified CV on the 712 labeled rows, sweeping thresholds 0.40–0.60, and adopt a shifted threshold only if it beats threshold=0.5 by a clear CV margin (>0.004). Model and features stay identical to the incumbent blend. This uses only training labels; external val IDs untouched. Expected runtime <90s. Output: predictions.csv (418), work/val_predictions.csv (179), metrics.json, comparison.csv, model joblib.</goal>\n<code>import os, json, hashlib, joblib, warnings\nimport numpy as np, pandas as pd\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.ensemble import ExtraTreesClassifier\nfrom sklearn.model_selection import RepeatedStratifiedKFold\nwarnings.filterwarnings("ignore")\n\nSEED = 42\nWARD = "work"; os.makedirs(WARD, exist_ok=True)\nbase = "../input/data"\ntrain = pd.read_csv(f"{base}/train_data/train.csv")\nval   = pd.read_csv(f"{base}/validation_data/validation.csv")\ntest  = pd.read_csv(f"{base}/predict_data/test.csv")\nassert len(train) == 712 and len(val) == 179 and len(test) == 418\n\nval_ids_path = f"{WARD}/val_ids.json"\nval_ids = val["PassengerId"].tolist()\nif os.path.exists(val_ids_path):\n    assert json.load(open(val_ids_path)) == val_ids, "val IDs changed"\nelse:\n    json.dump(val_ids, open(val_ids_path, "w"))\nassert not set(train["PassengerId"]) & set(val["PassengerId"])\nassert not set(train["PassengerId"]) & set(test["PassengerId"])\nassert not set(val["PassengerId"]) & set(test["PassengerId"])\n\ndef base_feat(df):\n    d = df.copy()\n    d["FamilySize"] = d["SibSp"] + d["Parch"] + 1\n    d["IsAlone"]    = (d["FamilySize"] == 1).astype(int)\n    t = d["Name"].str.extract(r",\\s*([^.]+)\\.", expand=False)\n    t = t.replace({"Mlle":"Miss","Ms":"Miss","Mme":"Mrs"}).fillna("Rare")\n    d["Embarked"] = d["Embarked"].fillna("M")\n    d["_Title"] = t\n    return d\n\ntr_full = base_feat(train); val_f = base_feat(val); te_f = base_feat(test)\ntc = tr_full["_Title"].value_counts(); rare = list(tc[tc < 10].index)\ndef set_title(d):\n    d = d.copy(); d["Title"] = d["_Title"].where(~d["_Title"].isin(rare), "Rare"); return d\ntr_full, val_f, te_f = set_title(tr_full), set_title(val_f), set_title(te_f)\n\nnum_cols = ["Pclass","SibSp","Parch","FamilySize","IsAlone"]\naf_cols  = ["Age","Fare"]; cat_cols = ["Sex","Embarked","Title"]\ncols = num_cols + af_cols + cat_cols\n\ndef make_pre():\n    return ColumnTransformer([\n        ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_cols),\n        ("af",  Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),\n        ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                          ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n    ])\n\ndef fit_blend(df):\n    X = df[cols]; y = df["Survived"].astype(int).values\n    lr = Pipeline([("pre", make_pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X,y)\n    et = Pipeline([("pre", make_pre()), ("et", ExtraTreesClassifier(\n        n_estimators=400, max_depth=6, min_samples_leaf=4, criterion="gini",\n        random_state=SEED, n_jobs=4))]).fit(X,y)\n    return lr, et\ndef blend_prob(lr, et, df):\n    Xf = df[cols]\n    return 0.5*lr.predict_proba(Xf)[:,1] + 0.5*et.predict_proba(Xf)[:,1]\n\n# ---- repeated CV: collect out-of-fold probabilities once ----\nrskf = RepeatedStratifiedKFold(n_splits=5, n_repeats=2, random_state=SEED)\noof_p, oof_y = [], []\nfor trk, vak in rskf.split(np.zeros(len(tr_full)), tr_full["Survived"].values):\n    d_tr = tr_full.iloc[trk].reset_index(drop=True)\n    d_va = tr_full.iloc[vak].reset_index(drop=True)\n    lr, et = fit_blend(d_tr)\n    oof_p.append(blend_prob(lr, et, d_va))\n    oof_y.append(d_va["Survived"].astype(int).values)\noof_p = np.concatenate(oof_p); oof_y = np.concatenate(oof_y)\n\nthrs = np.round(np.arange(0.40, 0.61, 0.02), 2)\nacc_by_thr = {float(t): float(((oof_p >= t).astype(int) == oof_y).mean()) for t in thrs}\nacc_05 = acc_by_thr[0.5]\nbest_thr = max(acc_by_thr, key=acc_by_thr.get)\nACCEPT = (acc_by_thr[best_thr] - acc_05) > 0.004 and best_thr != 0.5\nTHR = best_thr if ACCEPT else 0.5\n\n# ---- fit final model on FULL 712, apply chosen threshold ----\nlr_f, et_f = fit_blend(tr_full)\nval_pred  = (blend_prob(lr_f, et_f, val_f) >= THR).astype(int)\ntest_pred = (blend_prob(lr_f, et_f, te_f)  >= THR).astype(int)\n\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred.astype(int)})\npp.to_csv("predictions.csv", index=False)\nvp = pd.DataFrame({"PassengerId": val["PassengerId"].values, "Survived": val_pred.astype(int)})\nvp.to_csv(f"{WARD}/val_predictions.csv", index=False)\n\njoblib.dump({"lr": lr_f, "et": et_f, "w": 0.5, "threshold": THR,\n             "cols": cols, "title_rare": rare}, f"{WARD}/model_best.joblib")\n\n# ---- ledger ----\ncomp_path = f"{WARD}/comparison.csv"\nrows = [{"round":"threshold_cv","variant":f"thr={thr:.2f}","holdout_acc":round(a,4),\n         "accepted":(thr==THR and abs(thr-THR)<1e-9)} for thr, a in acc_by_thr.items()]\nif os.path.exists(comp_path):\n    cmp = pd.read_csv(comp_path)\n    for r in