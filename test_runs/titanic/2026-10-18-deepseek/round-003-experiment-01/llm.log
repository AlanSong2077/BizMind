ARD}/val_ids.json"\nval_ids = val["PassengerId"].tolist()\nif os.path.exists(val_ids_path):\n    assert json.load(open(val_ids_path)) == val_ids, "val IDs changed"\nelse:\n    json.dump(val_ids, open(val_ids_path, "w"))\nassert not set(train["PassengerId"]) & set(val["PassengerId"])\nassert not set(train["PassengerId"]) & set(test["PassengerId"])\nassert not set(val["PassengerId"]) & set(test["PassengerId"])\n\n# ---- featurize variants ----\ndef featurize(df, use_inter):\n    d = df.copy()\n    d["FamilySize"] = d["SibSp"] + d["Parch"] + 1\n    d["IsAlone"]    = (d["FamilySize"] == 1).astype(int)\n    t = d["Name"].str.extract(r",\\s*([^.]+)\\.", expand=False)\n    t = t.replace({"Mlle": "Miss", "Ms": "Miss", "Mme": "Mrs"}).fillna("Rare")\n    d["Embarked"] = d["Embarked"].fillna("M")\n    d["_Title"] = t\n    if use_inter:\n        # Sex x Pclass interactions as categorical strings\n        d["SexPclass"] = d["Sex"].astype(str) + "_" + d["Pclass"].astype(str)\n        # FareBand via quantile-ish thresholds (fixed, not label-based)\n        fb = pd.cut(d["Fare"], bins=[-1, 7.9, 14.5, 31, 1000], labels=["lo","mid","hi","vh"])\n        d["FareBand"] = fb.astype(str)\n    return d\n\nnum_base = ["Pclass","SibSp","Parch","FamilySize","IsAlone"]\naf_cols  = ["Age","Fare"]\ncat_base = ["Sex","Embarked","Title"]\n\ndef build_pre(cat_cols):\n    return ColumnTransformer([\n        ("num", Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler())]), num_base),\n        ("af",  Pipeline([("imp", SimpleImputer(strategy="median", add_indicator=True)), ("sc", StandardScaler())]), af_cols),\n        ("cat", Pipeline([("imp", SimpleImputer(strategy="constant", fill_value="M")),\n                          ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),\n    ])\n\nclass Blend(BaseEstimator, ClassifierMixin):\n    def __init__(self, use_inter=False, w=0.5, depth=6, leaf=4):\n        self.use_inter=use_inter; self.w=w; self.depth=depth; self.leaf=leaf\n    def _cols(self):\n        cats = cat_base + (["SexPclass","FareBand"] if self.use_inter else [])\n        return num_base + af_cols + cats, cats\n    def fit(self, df, y=None):\n        cols, cats = self._cols(); y = df["Survived"].astype(int).values; X = df[cols]\n        self.lr_ = Pipeline([("pre", build_pre(cats)),("lr",LogisticRegression(max_iter=2000,random_state=SEED))]).fit(X,y)\n        self.et_ = Pipeline([("pre", build_pre(cats)),("et",ExtraTreesClassifier(\n            n_estimators=400,max_depth=self.depth,min_samples_leaf=self.leaf,criterion="gini",\n            random_state=SEED,n_jobs=4))]).fit(X,y)\n        self.cols_=cols; return self\n    def predict_proba(self, df):\n        X=df[self.cols_]\n        p=self.w*self.lr_.predict_proba(X)[:,1]+(1-self.w)*self.et_.predict_proba(X)[:,1]\n        return np.vstack([1-p,p]).T\n    def predict(self, df): return (self.predict_proba(df)[:,1]>=0.5).astype(int)\n\ndef apply_rare(tr_df, dfs, rare_set):\n    out=[]\n    for d in [tr_df]+dfs:\n        d=d.copy(); d["Title"]=d["_Title"].where(~d["_Title"].isin(rare_set),"Rare"); out.append(d)\n    return out\n\n# rare map from FULL training (all CV folds share the same map -> mild but standard)\ntr0 = featurize(train, True)\ntc = tr0["_Title"].value_counts(); rare = tc[tc<10].index\ntr_full_i = featurize(train, True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))\nval_i     = featurize(val,  True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))\nte_i      = featurize(test, True).pipe(lambda d: d.assign(Title=d["_Title"].where(~d["_Title"].isin(rare),"Rare")))\n# non-inter versions just drop the extra cols at fit-time via use_inter flag\n\n# ---- 5-fold CV on 712 rows: compare candidates by CV accuracy ----\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\ndef cv_acc(params):\n    model = Blend(**params)\n    # cross_val_score needs arrays; we pass the df via index slicing\n    scores=[]\n    for trk, vak in skf.split(np.zeros(len(tr_full_i)), tr_full_i["Survived"].values):\n        d_tr = tr_full_i.iloc[trk].reset_index(drop=True)\n        d_va = tr_full_i.iloc[vak].reset_index(drop=True)\n        m = Blend(**params).fit(d_tr, d_tr["Survived"])\n        scores.append((m.predict(d_va)==d_va["Survived"].astype(int).values).mean())\n    return float(np.mean(scores))\n\ncandidates = {\n    "incumbent":      dict(use_inter=False, w=0.5, depth=6, leaf=4),\n    "interactions":   dict(use_inter=True,  w=0.5, depth=6, leaf=4),\n    "w60":            dict(use_inter=False, w=0.6, depth=6, leaf=4),\n    "w40":            dict(use_inter=False, w=0.4, depth=6, leaf=4),\n    "leaf3_depth7":   dict(use_inter=False, w=0.5, depth=7, leaf=3),\n    "inter_w60":      dict(use_inter=True,  w=0.6, depth=6, leaf=4),\n}\ncv_scores = {k: round(cv_acc(v),4) for k,v in candidates.items()}\ninc_cv = cv_scores["incumbent"]\nbest = max(cv_scores, key=cv_scores.get)\n# require a clear margin (>0.003 ~ 1 row on 712) to accept, to avoid noise\nACCEPT = (cv_scores[best] - inc_cv) > 0.003 and best != "incumbent"\nCHOSEN = best if ACCEPT else "incumbent"\nchosen_params = candidates[CHOSEN]\n\n# ---- retrain chosen on FULL 712 rows, predict val + test ----\nmodel = Blend(**chosen_params).fit(tr_full_i, tr_full_i["Survived"])\nval_pred  = model.predict(val_i)\ntest_pred = model.predict(te_i)\n\npp = pd.DataFrame({"PassengerId": test["PassengerId"].values, "Survived": test_pred.astype(int)})\npp.to_csv("predictions.csv", index=False)\nvp = pd.DataFrame({"PassengerId": val["PassengerId"].values, "Survived": val_pred.astype(int)})\nvp.to_csv(f"{WARD}/val_predictions.csv", index=False)\n\njoblib.dump({"model": model, "params": chosen_params, "rare": list(rare),\n             "threshold": 0.5}, f"{WARD}/model_best.joblib")\n\n# ---- comparison ledger ----\ncomp_path = f"{WARD}/comparison.csv"\nrows = [{"round":"cv5_select","variant":k,"holdout_acc":cv_scores[k],\n         "accepted":(k==CHOSEN)} for k in candidates]\nif os.path.exists(comp_path):\n    cmp = pd.read_csv(comp_path)\n    for r in rows: cmp = cmp[cmp["variant"] != r["variant"]]\n    cmp = pd.concat([cmp, pd.DataFrame(rows)], ignore_index=True)\nelse:\n    cmp = pd.DataFrame(rows)\ncmp.to_csv(comp_path, index=False)\n\nmetrics = {\n    "seed": SEED, "round": "cv5_select",\n    "selection": "5-fold stratified CV on 712 labeled rows (rs=42)",\n    "cv_scores": cv_scores, "incumbent_cv": inc_cv,\n    "chosen": CHOSEN, "chosen_params": chosen_params,\n    "accepted_over_incumbent": ACCEPT,\n    "external_incumbent_reference_acc": 0.8492,\n    "md5_val": hashlib.md5(open(f"{WARD}/val_predictions.csv","rb").read()).hexdigest()[:10],\n    "md5_test": hashlib.md5(open("predictions.csv","rb").read()).hexdigest()[:10],\n}\njson.dump(metrics, open(f"{WARD}/metrics.json","w"), indent=2)\n\nopen(f"{WARD}/README.txt","w").write(\n    f"ROUND cv5_select: 5-fold CV selection on 712 train rows.\\n"\n    f"CV scores: {cv_scores}\\nChosen: {CHOSEN} params={chosen_params} accepted={ACCEPT}\\n"\n    "Model: prob=w*p_LR+(1-w)*p_ET, Survived=1 if prob>=0.5. Seed 42, CPU n_jobs=4.\\n"\n    "Inference: featurize (Title rare-map, FamilySize, IsAlone, Embarked->M"\n    + (", SexPclass, FareBand" if chosen_params["use_inter"] else "") + ") then predict.\\n")\n\n# ---- assertions ----\nassert list(pp.columns)==["PassengerId","Survived"] and len(pp)==418\nassert pp["PassengerId"].tolist()==test["PassengerId"].tolist()\nassert list(vp.columns)==["PassengerId","Survived"] and len(vp)==179\nassert vp["PassengerId"].tolist()==val_ids\nassert set(pp["Survived"].unique())<={0,1} and set(vp["Survived"].unique())<={0,1}\n\nloaded = joblib.load(f"{WARD}/model_best.joblib")["model"]\nassert (loaded.predict(val_i)==vp["Survived"].values).all(), "val drift"\nassert (loaded.predict(te_i)==pp["Survived"].values).all(), "test drift"\n\nprint("CV scores:", cv_scores)\nprint("Chosen: %s (params=%s, accepted=%s)" % (CHOSEN, chosen_params, ACCEPT))\nprint("test pos rate %.3f | val pos rate %.3f" % (pp["Survived"].mean(), vp["Survived"].mean()))\nprint("Reproducibility OK.")\n</code>\n<validation_prediction_file>work/val_predictions.csv</validation_prediction_file>\n<prediction_file>predictions.csv</prediction_file>', role='assistant', tool_calls=None, function_call=None, provider_specific_fields=None), provider_specific_fields={})], usage=Usage(completion_tokens=3001, prompt_tokens=15235, total_tokens=18236, completion_tokens_details=None, prompt_tokens_details=PromptTokensDetailsWrapper(audio_tokens=None, cache_write_tokens=None, cached_tokens=14848, image_tokens=None, text_tokens=None), prompt_cache_hit_tokens=14848, prompt_cache_miss_tokens=387))
