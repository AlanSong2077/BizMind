  ])\n\ny = tr_f["Survived"].values\nX = tr_f[num_cols + af_cols + cat_cols]\n\n# ---- best-measured incumbent ----\nBW, BD, BL, BN = 0.5, 6, 4, 400\nlr_final = Pipeline([("pre", make_pre()), ("lr", LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X, y)\net_final = Pipeline([("pre", make_pre()), ("et", ExtraTreesClassifier(\n    n_estimators=BN, max_depth=BD, min_samples_leaf=BL,\n    random_state=SEED, n_jobs=4))]).fit(X, y)\n\nXv = val_f[num_cols + af_cols + cat_cols]\nXt = te_f[num_cols + af_cols + cat_cols]\ndef blend(Xf):\n    return BW * lr_final.predict_proba(Xf)[:, 1] + (1 - BW) * et_final.predict_proba(Xf)[:, 1]\n\nval_pred  = (blend(Xv) >= 0.5).astype(int)\ntest_pred = (blend(Xt) >= 0.5).astype(int)\n\npd.DataFrame({"PassengerId": val["PassengerId"], "Survived": val_pred}).to_csv(f"{WARD}/val_predictions.csv", index=False)\npp = pd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred})\npp.to_csv("predictions.csv", index=False)\n\nmetrics = {\n    "seed": SEED, "round": 11,\n    "decision": "final: reverted to best-measured incumbent (0.8492); r10 more trees (800) degraded to 0.8436",\n    "chosen": {"w": BW, "depth": BD, "leaf": BL, "n_estimators": BN},\n    "incumbent_fixed_val_accuracy": 0.8492,\n    "history": {"r4_cv_tuned": 0.8436, "r5_r7_r9_incumbent": 0.8492,\n                "r6_interactions": 0.8212, "r8_lr_et_gb": 0.8436, "r10_more_trees": 0.8436},\n    "note": "prob>=0.5 -> 1; both val/test predictions from same incumbent model; fixed-val acc scored by evaluator",\n}\njson.dump(metrics, open(f"{WARD}/metrics.json", "w"), indent=2)\njoblib.dump({"lr": lr_final, "et": et_final, "w": BW, "n_estimators": BN}, f"{WARD}/model_blend_best.joblib")\n\nopen(f"{WARD}/README.txt", "w").write(\n    "ROUND 11 - FINAL: best-measured incumbent LR+ExtraTrees soft-vote (0.8492)\\n"\n    f"Config: w={BW}, ET n_estimators={BN}, max_depth={BD}, min_samples_leaf={BL}.\\n"\n    "Features: num[Pclass,SibSp,Parch,FamilySize,IsAlone]; af[Age(m