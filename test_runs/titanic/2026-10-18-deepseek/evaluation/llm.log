t)),\n            "columns": list(train_split.columns),\n            "note": "Labeled training split (Survived included).",\n        },\n        "predict_data/test.csv": {\n            "rows": int(len(test)),\n            "columns": list(test.columns),\n            "note": "Unchanged unlabeled prediction inputs.",\n        },\n        "split": {\n            "strategy": "train_test_split(test_size=0.2, random_state=42, stratify=Survived)",\n            "seed": SEED,\n            "test_size": TEST_SIZE,\n            "rows_train": int(len(train_split)),\n            "rows_val": int(len(val_inputs)),\n            "rows_test": int(len(test)),\n        },\n    }\n    with open(os.path.join(public_dir, "validation_schema.json"), "w") as f:\n        json.dump(schema_doc, f, indent=2)\n\n    # Smoke-test sample predictions: valid IDs, required columns, constant 0\n    sample = pd.DataFrame({\n        "PassengerId": val_inputs["PassengerId"].values,\n        "Survived": 0,\n    })\n    sample.to_csv(os.path.join(public_dir, "validation_sample_predictions.csv"), index=False)\n\n    # Print layout\n    print("Split strategy: train_test_split(test_size=0.2, random_state=42, stratify=Survived)")\n    print(f"input_dir  = {input_dir}")\n    print(f"public_dir = {public_dir}")\n    print(f"private_dir= {private_dir}")\n    print(f"rows_train = {len(train_split)}")\n    print(f"rows_val   = {len(val_inputs)}")\n    print(f"rows_test  = {len(test)}")\n    print("Public layout:")\n    for root, _, files in os.walk(public_dir):\n        for fn in sorted(files):\n            rel = os.path.relpath(os.path.join(root, fn), public_dir)\n            print(f"  {rel}")\n    print("Private layout:")\n    for root, _, files in os.walk(private_dir):\n        for fn in sorted(files):\n            rel = os.path.relpath(os.path.join(root, fn), private_dir)\n            print(f"  {rel}")\n\n\nif __name__ == "__main__":\n    main()\n</code>\n\n<current_file>evaluate.py</current_file>\n<explanation>\nThe evaluator loads private validation labels, the public validation inputs (for the expected ID set and order), and the supplied prediction CSV. It strictly validates: required columns exactly {PassengerId, Survived}, row count matching, no duplicate IDs, no missing or extra IDs, and Survived values in {0,1} (integers). Rows are aligned by PassengerId to private truth before computing accuracy = correct / total. On any validation failure it writes eval_report.json with score null, success false, and an explanatory message. It never trains a model nor modifies the split. On success, it writes {"score": accuracy, "success": true, "message": ""} to private_dir/eval_report.json and prints it.\n</explanation>\n<code>\nimport argparse\nimport json\nimport os\nimport sys\n\nimport pandas as pd\n\n\nREQUIRED_COLUMNS = ["PassengerId", "Survived"]\n\n\ndef fail(private_dir, message):\n    report = {"score": None, "success": False, "message": message}\n    try:\n        with open(os.path.join(private_dir, "eval_report.json"), "w") as f:\n            json.dump(report, f)\n    except Exception:\n        pass\n    print(json.dumps(report))\n    sys.exit(1)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument("--public_dir", required=True)\n    ap.add_argument("--private_dir", required=True)\n    ap.add_argument("--pred", required=True)\n    args = ap.parse_args()\n\n    public_dir = os.path.abspath(args.public_dir)\n    private_dir = os.path.abspath(args.private_dir)\n    pred_path = os.path.abspath(args.pred)\n\n    os.makedirs(private_dir, exist_ok=True)\n\n    labels_path = os.path.join(private_dir, "validation_labels.csv")\n    val_inputs_path = os.path.join(public_dir, "validation_data", "validation.csv")\n\n    if not os.path.isfile(labels_path):\n        fail(private_dir, f"missing private validation labels: {labels_path}")\n    if not os.path.isfile(val_inputs_path):\n        fail(private_dir, f"missing public validation inputs: {val_inputs_path}")\n    if not os.path.isfile(pred_path):\n        fail(private_dir, f"missing prediction file: {pred_path}")\n\n    try:\n        labels = pd.read_csv(labels_path)\n        val_inputs = pd.read_csv(val_inputs_path)\n        pred = pd.read_csv(pred_path)\n    except Exception as e:\n        fail(private_dir, f"failed reading inputs: {e}")\n\n    if list(labels.columns) != REQUIRED_COLUMNS:\n        fail(private_dir, f"private labels must have columns {REQUIRED_COLUMNS}, got {list(labels.columns)}")\n\n    if list(pred.columns) != REQUIRED_COLUMNS:\n        fail(private_dir, f"prediction file must have exactly columns {REQUIRED_COLUMNS}, got {list(pred.columns)}")\n\n    # Rows\n    if len(pred) != len(labels):\n        fail(private_dir, f"prediction row count {len(pred)} != expected {len(labels)}")\n\n    # IDs\n    if pred["PassengerId"].isnull().any():\n        fail(private_dir, "prediction contains null PassengerId")\n    if pred["PassengerId"].duplicated().any():\n        dups = pred.loc[pred["PassengerId"].duplicated(), "PassengerId"].tolist()\n        fail(private_dir, f"duplicate PassengerId in prediction: {dups[:10]}")\n\n    expected_ids = set(labels["PassengerId"].tolist())\n    pred_ids = set(pred["PassengerId"].tolist())\n    if pred_ids != expected_ids:\n        missing = list(expected_ids - pred_ids)[:10]\n        extra = list(pred_ids - expected_ids)[:10]\n        fail(private_dir, f"PassengerId mismatch. missing={missing} extra={extra}")\n\n    # Also ensure validation inputs cover same IDs (sanity, non-blocking correctness requirement)\n    if set(val_inputs["PassengerId"].tolist()) != expected_ids:\n        fail(private_dir, "public validation input IDs do not match private label IDs")\n\n    # Survival values\n    surv = pred["Survived"]\n    if surv.isnull().any():\n        fail(private_dir, "prediction contains null Survived")\n    # Accept numeric or numeric-like\n    if not pd.api.types.is_numeric_dtype(surv):\n        fail(private_dir, f"Survived must be numeric, got dtype {surv.dtype}")\n    nonfinite = ~pd.to_numeric(surv, errors="coerce").apply(lambda x: 0.0 if pd.isna(x) else (1.0 if abs(x) < 1e9 else 0.0)).astype(bool)\n    # Simpler finite check:\n    vals = surv.astype(float)\n    import math\n    for v in vals.tolist():\n        if not math.isfinite(v):\n            fail(private_dir, "prediction contains non-finite Survived values")\n    if not vals.isin([0.0, 1.0]).all():\n        bad = sorted(set(vals[~vals.isin([0.0, 1.0])].tolist()))[:10]\n        fail(private_dir, f"Survived must be 0 or 1, got values like {bad}")\n\n    pred_int = vals.astype(int)\n    pred_aligned = pd.DataFrame({\n        "PassengerId": pred["PassengerId"].astype(labels["PassengerId"].dtype, errors="ignore"),\n        "Survived": pred_int,\n    })\n\n    merged = labels.merge(pred_aligned, on="PassengerId", how="inner", suffixes=("_true", "_pred"))\n    if len(merged) != len(labels):\n        fail(private_dir, f"internal alignment failure: merged {len(merged)} vs expected {len(labels)}")\n\n    correct = int((merged["Survived_true"] == merged["Survived_pred"]).sum())\n    total = int(len(merged))\n    accuracy = correct / total if total > 0 else 0.0\n\n    report = {"score": accuracy, "success": True, "message": ""}\n    with open(os.path.join(private_dir, "eval_report.json"), "w") as f:\n        json.dump(report, f)\n    print(json.dumps(report))\n    print(f"accuracy = {correct}/{total} = {accuracy:.6f}")\n\n\nif __name__ == "__main__":\n    main()\n</code>'}, {'role': 'user', 'content': 'Execution success: True\nOutput:\nSplit strategy: train_test_split(test_size=0.2, random_state=42, stratify=Survived)\ninput_dir  = <PROJECT_ROOT>/workspace/titanic-local/20261018_232515_665206/task_data\npublic_dir = <PROJECT_ROOT>/workspace/titanic-local/20261018_232515_665206/evaluation/public\nprivate_dir= <PROJECT_ROOT>/workspace/titanic-local/20261018_232515_665206/evaluation/private\nrows_train = 712\nrows_val   = 179\nrows_test  =