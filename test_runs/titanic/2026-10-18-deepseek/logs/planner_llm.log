        return t\n    d[\'Title\'] = d[\'Name\'].map(title)\n    return d\n\ntr_f, va_f, te_f = featurize(tr), featurize(va), featurize(te)\ntitle_counts = tr_f[\'Title\'].value_counts()\nrare = title_counts[title_counts < 10].index\nfor d in (tr_f, va_f, te_f):\n    d[\'Title\'] = d[\'Title\'].where(~d[\'Title\'].isin(rare), \'Rare\')\ntr_f[\'Embarked\'] = tr_f[\'Embarked\'].fillna(\'M\'); va_f[\'Embarked\'] = va_f[\'Embarked\'].fillna(\'M\'); te_f[\'Embarked\'] = te_f[\'Embarked\'].fillna(\'M\')\n\nnum = [\'Pclass\', \'SibSp\', \'Parch\', \'FamilySize\', \'IsAlone\']\naf = [\'Age\', \'Fare\']\ncat = [\'Sex\', \'Embarked\', \'Title\']\npre = ColumnTransformer([\n    (\'num\', StandardScaler(), num),\n    (\'af\', Pipeline([(\'imp\', SimpleImputer(strategy=\'median\', add_indicator=True)),\n                     (\'sc\', StandardScaler())]), af),\n    (\'cat\', Pipeline([(\'imp\', SimpleImputer(strategy=\'constant\', fill_value=\'M\')),\n                      (\'oh\', OneHotEncoder(handle_unknown=\'ignore\'))]), cat),\n])\n\ndef fit_models(X, y, depth, leaf):\n    lr = Pipeline([(\'pre\', pre), (\'lr\', LogisticRegression(max_iter=2000, random_state=SEED))]).fit(X, y)\n    et = Pipeline([(\'pre\', pre), (\'et\', ExtraTreesClassifier(\n        n_estimators=400, max_depth=depth, min_samples_leaf=leaf, random_state=SEED, n_jobs=4))]).fit(X, y)\n    return lr, et\n\ny = tr_f[\'Survived\'].values\nX = tr_f.drop(columns=[\'Survived\'])\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\nfolds = list(skf.split(X, y))\n\nresults = []\nfor depth in [5, 6, 7, 8]:\n    for leaf in [2, 3, 4, 6]:\n        oof_lr = np.zeros(len(y)); oof_et = np.zeros(len(y))\n        for tr_idx, va_idx in folds:\n            lr, et = fit_models(X.iloc[tr_idx], y[tr_idx], depth, leaf)\n            oof_lr[va_idx] = lr.predict_proba(X.iloc[va_idx])[:, 1]\n            oof_et[va_idx] = et.predict_proba(X.iloc[va_idx])[:, 1]\n        for w in [0.4, 0.5, 0.6, 0.7]:\n            prob = w * oof_lr + (1 - w) * oof_et\n            acc = accuracy_score(y, (prob >= 0.5).astype(int))\n            results.append(dict(w=w, depth=depth, leaf=leaf, cv_acc=acc))\nres = pd.DataFrame(results).sort_values(\'cv_acc\', ascending=False).reset_index(drop=True)\nres.to_csv(f\'{WARD}/sweep_comparison.csv\', index=False)\nbest = res.iloc[0]\nprint(res.head(10).to_string())\n\n# fit final CV-chosen config on all 712 training rows\nlr, et = fit_models(X, y, int(best.depth), int(best.leaf))\nXv = va_f.reindex(columns=X.columns)\nprob_v = best.w * lr.predict_proba(Xv)[:, 1] + (1 - best.w) * et.predict_proba(Xv)[:, 1]\nval_pred = (prob_v >= 0.5).astype(int)\n# Note: report val accuracy here only if evaluator is available; per protocol do NOT read validation labels.\n# We write predictions; the evaluator will score them. We record the CV number for the chosen config.\nmetrics = {\'cv_mean\': float(best.cv_acc), \'chosen\': {\'w\': float(best.w), \'depth\': int(best.depth), \'leaf\': int(best.leaf)},\n           \'incumbent_val_accuracy\': 0.8492, \'note\': \'fixed-validation accuracy measured by evaluator\'}\njson.dump(metrics, open(f\'{WARD}/metrics.json\', \'w\'), indent=2)\n\npd.DataFrame({\'PassengerId\': va[\'PassengerId\'], \'Survived\': val_pred}).to_csv(f\'{WARD}/val_predictions.csv\', index=False)\n\nXt = te_f.reindex(columns=X.columns)\nprob_t = best.w * lr.predict_proba(Xt)[:, 1] + (1 - best.w) * et.predict_proba(Xt)[:, 1]\ntest_pred = (prob_t >= 0.5).astype(int)\npd.DataFrame({\'PassengerId\': te[\'PassengerId\'], \'Survived\': test_pred}).to_csv(\'predictions.csv\', index=False)\nassert len(test_pred) == 418 and set(np.unique(test_pred)).issubset({0, 1})\n\njoblib.dump({\'lr\': lr, \'et\': et, \'w\': float(best.w)}, f\'{WARD}/model_blend_best.joblib\')\nwith open(f\'{WARD}/README.txt\', \'w\') as f:\n    f.write(\'prob >= 0.5 -> 1; validation and test predictions from the same CV-tuned LR+ET blend.\\n\')\nprint(\'wrote predictions.csv and work/val_predictions.csv