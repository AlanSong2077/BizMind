test_flip = int(((test_prob >= 0.5).astype(int) != test_pred).sum())

pd.DataFrame({"PassengerId": val["PassengerId"], "Survived": val_pred}).to_csv(f"{WARD}/val_predictions.csv", index=False)
pp = pd.DataFrame({"PassengerId": test["PassengerId"], "Survived": test_pred})
pp.to_csv("predictions.csv", index=False)

metrics = {
    "seed": SEED, "round": 12,
    "change": "decision threshold 0.5 -> 0.45 on the incumbent blend (model unchanged)",
    "chosen": {"w": BW, "depth": BD, "leaf": BL, "n_estimators": BN, "threshold": THR},
    "incumbent_fixed_val_accuracy": 0.8492,
    "val_flips_vs_0.5": val_flip, "test_flips_vs_0.5": test_flip,
