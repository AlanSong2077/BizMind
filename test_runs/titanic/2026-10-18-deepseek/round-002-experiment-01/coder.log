    "note": "prob>=threshold -> 1; both val/test predictions from same model; fixed-val acc scored by evaluator",
}
json.dump(metrics, open(f"{WARD}/metrics.json", "w"), indent=2)
joblib.dump({"lr": lr_final, "et": et_final, "w": BW, "n_estimators": BN, "threshold": THR},
