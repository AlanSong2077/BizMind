val_prob  = blend(Xv)
test_prob = blend(Xt)
val_pred  = (val_prob  >= THR).astype(int)
test_pred = (test_prob >= THR).astype(int)

# report how many rows differ from threshold 0.5 (diagnostic; no labels used)
