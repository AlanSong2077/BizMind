        d = df.copy()
        for c in ["DebtRatio","MonthlyIncome"]:
            d[c] = np.log1p(np.clip(d[c], -0.999, None))
        return d
    scaler = StandardScaler().fit(tf(fit_df))
    return scaler, [scaler.transform(tf(ds)) for ds in dss]
