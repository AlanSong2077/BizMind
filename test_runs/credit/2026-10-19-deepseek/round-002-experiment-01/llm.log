nment>\nUse torch.device(os.environ[\'BIZMIND_DEVICE\']) for PyTorch models and tensors.\nDo not hardcode .cuda(). On MPS/CPU do not require CUDA-only operations or packages.\nUse CPU for libraries without support for the detected accelerator and choose\nmodel and batch sizes that fit available memory.\n\nRespond with exactly one executable notebook cell, using these tags:\n<goal>Hypothesis, expected runtime, expected output and how it tests the hypothesis</goal>\n<code>Python code for the next cell, without Markdown fences</code>\n<validation_prediction_file>Relative file path for complete validation predictions, or None</validation_prediction_file>\n<prediction_file>Relative file path for complete business prediction output, or None</prediction_file>\nBoth file tags must be None unless this cell writes BOTH complete outputs.\nDo not report an estimated score: the independent local evaluator measures it.\n'}, {'role': 'assistant', 'content': '<goal>Establish the reproducible LightGBM baseline and write both complete prediction files. Runtime ~60-120s. Expected output: audit summary, internal holdout AUC printed, validation_predictions.csv (30000 rows) and predictions.csv (101503 rows). This directly tests whether a median-imputed LightGBM beats 0.5 on the fixed validation set (evaluator scores it).</goal>\n<code>import os, glob, json, numpy as np, pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\n\nSEED = 42\nos.environ.setdefault("OMP_NUM_THREADS", "4")\nBASE = "../input/data"\nTRAIN = f"{BASE}/train_data/train.csv"\nTEST  = f"{BASE}/predict_data/test.csv"\nVAL   = f"{BASE}/validation_data/validation_features.csv"\n\ntrain = pd.read_csv(TRAIN)\ntest  = pd.read_csv(TEST)\nval   = pd.read_csv(VAL)\nprint("shapes train/test/val:", train.shape, test.shape, val.shape)\nprint("train cols:", list(train.columns))\nprint("val cols:", list(val.columns))\nassert "SeriousDlqin2yrs" in train.columns\nassert "Id" in test.columns and "Id" in val.columns\n\nfeatures = [c for c in train.columns if c not in ("Id", "SeriousDlqin2yrs")]\nprint("features:", features)\ny = train["SeriousDlqin2yrs"].values\n\n# ---- data-quality audit ----\naudit = {"n_train": int(len(train)), "pos_rate": float(train.SeriousDlqin2yrs.mean()),\n         "missing": train[features].isna().sum().to_dict(),\n         "ru_gt1": int((train["RevolvingUtilizationOfUnsecuredLines"] > 1).sum())}\nfor c in ["NumberOfTime30-59DaysPastDueNotWorse","NumberOfTimes90DaysLate","NumberOfTime60-89DaysPastDueNotWorse"]:\n    audit[f"{c}_sentinel_96_98"] = int(train[c].isin([96,98]).sum())\naudit["DebtRatio_q"] = {str(k): float(v) for k,v in train["DebtRatio"].quantile([.5,.9,.99,.995]).items()}\naudit["MonthlyIncome_q"] = {str(k): float(v) for k,v in train["MonthlyIncome"].quantile([.5,.9,.99,.995]).items()}\naudit["dup_feature_rows"] = int(train[features].duplicated().sum())\nprint(json.dumps(audit, indent=2, default=str))\n\n# ---- median impute, fit ONLY on 120k train ----\nimpute_cols = ["MonthlyIncome","NumberOfDependents"]\nmedians = {c: float(train[c].median()) for c in impute_cols}\nprint("medians:", medians)\ndef prep(df):\n    X = df[features].copy()\n    for c, m in medians.items():\n        X[c] = X[c].fillna(m)\n    return X\n\nXfree_full = prep(train)\nXte  = prep(test)\nXval = prep(val)\n\n# internal holdout for early stopping (fixed val labels never touched here)\nXtr, Xho, ytr, yho = train_test_split(Xfree_full, y, test_size=0.15, stratify=y, random_state=SEED)\n\nmodel = lgb.LGBMClassifier(objective="binary", num_leaves=31, learning_rate=0.05,\n                           n_estimators=600, subsample=0.9, colsample_bytree=0.9,\n                           random_state=SEED, n_jobs=4, metric="auc", verbose=-1)\nmodel.fit(Xtr, ytr, eval_set=[(Xho, yho)], eval_metric="auc",\n          callbacks=[lgb.early_stopping(50, verbose=False), lgb.log_evaluation(0)])\nho_auc = roc_auc_score(yho, model.predict_proba(Xho)[:,1])\nprint("holdout AUC:", ho_auc, "best_iter:", model.best_iteration_)\n\nval_prob  = model.predict_proba(Xval)[:,1]\ntest_prob = model.predict_proba(Xte)[:,1]\nfor nm, p in [("val", val_prob), ("test", test_prob)]:\n    assert np.isfinite(p).all() and p.min() >= 0 and p.max() <= 1, nm\nprint("val_prob range:", val_prob.min(), val_prob.max())\n\n# ---- outputs ----\nos.makedirs("artifacts", exist_ok=True)\nval_out = pd.DataFrame({"Id": val["Id"].values, "Probability": val_prob})\nassert len(val_out) == 30000 and val_out["Id"].is_unique\nval_out.to_csv("validation_predictions.csv", index=False)\n\npred_out = pd.DataFrame({"Id": test["Id"].values, "Probability": test_prob})\nassert len(pred_out) == 101503 and list(pred_out.columns) == ["Id","Probability"]\nassert pred_out["Id"].is_unique\npred_out.to_csv("predictions.csv", index=False)\n\n# ---- artifacts ----\nmodel.booster_.save_model("artifacts/lgbm_baseline.txt")\njson.dump({"medians": medians, "features": features, "holdout_auc": ho_auc,\n           "best_iteration": int(model.best_iteration_), "audit": audit,\n           "params": {"num_leaves":31,"lr":0.05,"n_estimators":600,"seed":SEED,"n_jobs":4}},\n          open("artifacts/run_meta.json","w"), indent=2, default=str)\nwith open("artifacts/run_log.txt","w") as f:\n    f.write(f"LightGBM median-impute baseline\\nholdout_auc={ho_auc:.6f}\\n"\n            f"best_iteration={model.best_iteration_}\\nfeatures={features}\\n"\n            f"impute_medians={medians}\\n")\nwith open("artifacts/README.md","w") as f:\n    f.write("# Inference\\n1) read features list from run_meta.json\\n"\n            "2) fillna MonthlyIncome/NumberOfDependents with stored medians\\n"\n            "3) booster.predict -> pos prob\\n")\nprint("done; rows:", len(val_out), len(pred_out))\n</code>\n<validation_prediction_file>validation_predictions.csv</validation_prediction_file>\n<prediction_file>predictions.csv</prediction_file>'}, {'role': 'user', 'content': 'Exec