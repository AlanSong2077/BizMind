\',\n          \'MonthlyIncome_missing\',\'NumberOfDependents_missing\',\'delinq_sentinel\',\'ru_clipped\',\'ru_gt1_flag\',\n          \'DebtRatio_is_income\',\'total_delinq\',\'income_per_dependent\',\'debt_per_income\']\nfeat28 = feat19 + [\'log_MonthlyIncome\',\'log_DebtRatio\',\'delinq_weighted\',\'ru_x_delinq\',\'debt_per_line\',\n                   \'income_per_line\',\'has_delinq_any\',\'age_x_delinq\',\'re_loan_ratio\']\n\nfull = build(train); te = build(test); va = build(val)\ny = train["SeriousDlqin2yrs"].values\nXtr_full19, Xtr_full28 = full[feat19], full[feat28]\nXte19, Xte28 = te[feat19], te[feat28]\nXva19, Xva28 = va[feat19], va[feat28]\n\nXtr19, Xho19, ytr, yho = train_test_split(Xtr_full19, y, test_size=0.15, stratify=y, random_state=SEED)\nXtr28, Xho28, _, _        = train_test_split(Xtr_full28, y, test_size=0.15, stratify=y, random_state=SEED)\n\ndef lgbm_make(seed, n_it):\n    return lgb.LGBMClassifier(objective="binary", num_leaves=15, learning_rate=0.03,\n                              n_estimators=n_it, min_child_samples=40, subsample=0.9,\n                              subsample_freq=1, colsample_bytree=0.8, reg_lambda=1.0,\n                              random_state=seed, n_jobs=4, metric="auc", verbose=-1)\n\n# holdout iter tuning per feature set\np19 = lgbm_make(SEED,1500); p19.fit(Xtr19,ytr,eval_set=[(Xho19,yho)],eval_metric="auc",\n    callbacks=[lgb.early_stopping(100,verbose=False), lgb.log_evaluation(0)])\nn19 = max(120,int((p19.best_iteration_ or 300)*1.1))\np28 = lgbm_make(SEED,1500); p28.fit(Xtr28,ytr,eval_set=[(Xho28,yho)],eval_metric="auc",\n    callbacks=[lgb.early_stopping(100,verbose=False), lgb.log_evaluation(0)])\nn28 = max(120,int((p28.best_iteration_ or 300)*1.1))\n\n# bag each feature set on holdout\nseeds = [42,7,123,2024]\nho19 = np.zeros(len(Xho19)); ho28 = np.zeros(len(Xho28))\nfor sd in seeds:\n    m=lgbm_make(sd,n19); m.fit(Xtr19,ytr); ho19 += m.predict_proba(Xho19)[:,1]\n    m=lgbm_make(sd,n28); m.fit(Xtr28,ytr); ho28 += m.predict_proba(Xho28)[:,1]\nho19/=len(seeds); ho28/=len(seeds)\nauc19=roc_auc_score(yho,ho19); auc28=roc_auc_score(yho,ho28)\n\n# LR on 28-feat\ndef prep_lr(fit_df, *dss):\n    cols = ["DebtRatio","MonthlyIncome","debt_per_income","income_per_dependent","log_MonthlyIncome","log_DebtRatio"]\n    def tf(df):\n        d = df.copy()\n        for c in ["DebtRatio","MonthlyIncome"]:\n            d[c] = np.log1p(np.clip(d[c], -0.999, None))\n        return d\n    scaler = StandardScaler().fit(tf(fit_df))\n    return scaler, [scaler.transform(tf(ds)) for ds in dss]\nsc_full, (Xtr28_s, Xho28_s) = prep_lr(Xtr28, Xtr28, Xho28)\nlr = LogisticRegression(C=0.5, max_iter=2000, n_jobs=4, random_state=SEED)\nlr.fit(Xtr28_s, ytr); ho_lr = lr.predict_proba(Xho28_s)[:,1]; auc_lr = roc_auc_score(yho,ho_lr)\n\n# grid blend weights on holdout (rank-normalized)\nr19=rankdata(ho19); r28=rankdata(ho28); rlr=rankdata(ho_lr)\nbest=(auc19,(1.0,0.0,0.0))\nfor w19 in np.linspace(0,1,11):\n    for w28 in np.linspace(0,1-w19,11):\n        wlr = 1-w19-w28\n        a = roc_auc_score(yho, w19*r19+w28*r28+wlr*rlr)\n        if a>best[0]: best=(a,(w19,w28,wlr))\nauc_bl, (w19,w28,wlr) = best\nprint(f"holdout: 19bag={auc19:.6f} 28bag={auc28:.6f} lr={auc_lr:.6f} -> blend={auc_bl:.6f} w={best[1]}")\n\n# refit all on full train and predict\nval19=np.zeros(len(Xva19)); val28=np.zeros(len(Xva28)); val_lr_parts=[]\ntst19=np.zeros(len(Xte19)); tst28=np.zeros(len(Xte28))\nfor sd in seeds:\n    m=lgbm_make(sd,n19); m.fit(Xtr_full19,y)\n    val19+=m.predict_proba(Xva19)[:,1]; tst19+=m.predict_proba(Xte19)[:,1]\n    m=lgbm_make(sd,n28); m.fit(Xtr_full28,y)\n    val28+=m.predict_proba(Xva28)[:,1]; tst28+=m.predict_proba(Xte28)[:,1]\nval19/=len(seeds); val28/=len(seeds); tst19/=len(seeds); tst28/=len(seeds)\n\nscF, (Xtr28F_s,) = prep_lr(Xtr_full28, Xtr_full28)\nlrF = LogisticRegression(C=0.5, max_iter=2000, n_jobs=4, random_state=SEED); lrF.fit(Xtr28F_s, y)\nval_lr = lrF.predict_proba(scF.transform(np.log1p(np.clip(Xva28[["DebtRatio","MonthlyIncome"]], -0.999, None)).join(\n    Xva28[["debt_per_income","income_per_dependent","log_MonthlyIncome","log_DebtRatio"]]).pipe(lambda d: d.assign(**{\n        "DebtRatio": np.log1p(np.clip(Xva28["DebtRatio"],-0.999,None)),\n        "MonthlyIncome": np.log1p(np.clip(Xva28["MonthlyIncome"],-0.999,None))})[["RevolvingUtilizationOfUnsecuredLines","age","NumberOfTime30-59DaysPastDueNotWorse","DebtRatio","MonthlyIncome","NumberOfOpenCreditLinesAndLoans","NumberOfTimes90DaysLate","NumberRealEstateLoansOrLines","NumberOfTime60-89DaysPastDueNotWorse","NumberOfDependents","MonthlyIncome_missing","NumberOfDependents_missing","delinq_sentinel","ru_clipped","ru_gt1_flag","DebtRatio_is_income","total_delinq","income_per_dependent","debt_per_income","log_MonthlyIncome","log_DebtRatio","delinq_weighted","ru_x_delinq","debt_per_line","income_per_line","has_delinq_any","age_x_delinq","re_loan_ratio"]]))[:,1]\n\ndef lr_pred(X28):\n    d = X28.copy()\n    for c in ["DebtRatio","MonthlyIncome"]:\n        d[c] = np.log1p(np.clip(d[c], -0.999, None))\n    return lrF.predict_proba(scF.transform(d))[:,1]\n\nval_lr = lr_pred(Xva28); tst_lr = lr_pred(Xte28)\n\ndef blend(p19,p28,plr):\n    r1=rankdata(p19)/len(p19); r2=rankdata(p28)/len(p28); r3=rankdata(plr)/len(plr)\n    s = w19*r1 + w28*r2 + wlr*r3\n    return (s - s.min())/(s.max()-s.min()+1e-12)\n\nval_prob = blend(val19, val28, val_lr)\ntst_prob = blend(tst19, tst28, tst_lr)\nfor nm,p in [("val",val_prob),("test",tst_prob)]:\n    assert np.isfinite(p).all() and p.min()>=0 and p.max()<=1, nm\n\nos.makedirs("artifacts", exist_ok=True)\npd.DataFrame({"Id":val["Id"].values,"Probability":val_prob}).to_csv("validation_predictions.csv", index=False)\npo = pd.DataFrame({"Id":test["Id"].values,"Probability":tst_prob})\nassert len(po)==101503 and list(po.columns)==["Id","Probability"] and po["Id"].is_unique\npo.to_csv("predictions.csv", index=False)\n\njson.dump({"auc19":auc19,"auc28":auc28,"auc_lr":auc_lr,"auc_blen