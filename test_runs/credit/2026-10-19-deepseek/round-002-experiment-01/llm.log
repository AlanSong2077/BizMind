alse)\n\n# integrity\nassert len(vout)==30000 and vout["Id"].is_unique and set(vout["Id"])==set(val["Id"])\nassert len(po)==101503 and list(po["Id"].values)==list(test["Id"].values)\n\nfor i,b in enumerate(bst): b.save_model(f"artifacts/lgbm_bag33_s8_{seeds[i]}.txt")\njson.dump({"auc_probe":auc_probe,"auc_bag":auc_bag,"n_it":n_it,"seeds":seeds,"features":feat,"medians":medians},\n          open("artifacts/run_meta_bag33_s8.json","w"), indent=2)\nwith open("artifacts/README.md","w") as f:\n    f.write("Pipeline: build() median-imputes MonthlyIncome/NumberOfDependents (train medians), "\n            "caps delinq sentinels {96,98}->20 with flag, clips RU to [0,1.5], builds 33 features. "\n            f"LightGBM binary num_leaves=15 lr=0.03 subsample=0.9 colsample=0.8 reg_lambda=1.0 min_child_samples=40 n_it={n_it}. "\n            f"8-seed bag {seeds} averaged probs. Inference: apply build() with medians, average predict_proba[:,1].\\n")\nprint("done rows:", len(vout), len(po))\n\nimport os, json, numpy as np, pandas as pd\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import QuantileTransformer\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.pipeline import Pipeline\nimport lightgbm as lgb\n\nSEED = 42\nos.environ.setdefault("OMP_NUM_THREADS", "4")\nBASE = "../input/data"\ntrain = pd.read_csv(f"{BASE}/train_data/train.csv")\ntest  = pd.read_csv(f"{BASE}/predict_data/test.csv")\nval   = pd.read_csv(f"{BASE}/validation_data/validation_features.csv")\n\ndelinq = ["NumberOfTime30-59DaysPastDueNotWorse","NumberOfTimes90DaysLate","NumberOfTime60-89DaysPastDueNotWorse"]\nimpute_cols = ["MonthlyIncome","NumberOfDependents"]\nmedians = {c: float(train[c].median()) for c in impute_cols}\n\ndef build(df):\n    X = df.copy()\n    X["MonthlyIncome_missing"] = X["MonthlyIncome"].isna().astype(int)\n    X["NumberOfDependents_missing"] = X["NumberOfDependents"].isna().astype(int)\n    X["d