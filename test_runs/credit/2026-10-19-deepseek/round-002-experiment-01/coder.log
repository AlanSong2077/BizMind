vpA=np.zeros(len(va)); tpA=np.zeros(len(te))
for sd in seeds_full_A:
    m=makeA(sd); m.fit(full,y)
    vpA+=m.predict_proba(va)[:,1]; tpA+=m.predict_proba(te)[:,1]
vpA/=len(seeds_full_A); tpA/=len(seeds_full_A)

if use_blend and best_w>0:
    vpB=np.zeros(len(va)); tpB=np.zeros(len(te))
    for sd in seedsB:
        m=makeB(sd); m.fit(full,y)
        vpB+=m.predict_proba(va)[:,1]; tpB+=m.predict_proba(te)[:,1]
    vpB/=len(seedsB); tpB/=len(seedsB)
    vp = (1-best_w)*vpA + best_w*vpB
    tp = (1-best_w)*tpA + best_w*tpB
else:
    vp, tp = vpA, tpA

vp=np.clip(vp,0,1); tp=np.clip(tp,0,1)
assert np.isfinite(vp).all() and np.isfinite(tp).all()

