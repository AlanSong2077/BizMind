n19 = max(120,int((p19.best_iteration_ or 300)*1.1))
p28 = lgbm_make(SEED,1500); p28.fit(Xtr28,ytr,eval_set=[(Xho28,yho)],eval_metric="auc",
    callbacks=[lgb.early_stopping(100,verbose=False), lgb.log_evaluation(0)])
n28 = max(120,int((p28.best_iteration_ or 300)*1.1))

seeds = [42,7,123,2024]
ho19 = np.zeros(len(Xho19)); ho28 = np.zeros(len(Xho28))
for sd in seeds:
