import os, glob, json, numpy as np, pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import roc_auc_score
import lightgbm as lgb

SEED = 42
os.environ.setdefault("OMP_NUM_THREADS", "4")
BASE = "../input/data"
TRAIN = f"{BASE}/train_data/train.csv"
TEST  = f"{BASE}/predict_data/test.csv"
VAL   = f"{BASE}/validation_data/validation_features.csv"

train = pd.read_csv(TRAIN)
test  = pd.read_csv(TEST)
val   = pd.read_csv(VAL)
print("shapes train/test/val:", train.shape, test.shape, val.shape)
print("train cols:", list(train.columns))
print("val cols:", list(val.columns))
assert "SeriousDlqin2yrs" in train.columns
assert "Id" in test.columns and "Id" in val.columns

features = [c for c in train.columns if c not in ("Id", "SeriousDlqin2yrs")]
print("features:", features)
y = train["SeriousDlqin2yrs"].values

# ---- data-quality audit ----
audit = {"n_train": int(len(train)), "pos_rate": float(train.SeriousDlqin2yrs.mean()),
         "missing": train[features].isna().sum().to_dict(),
         "ru_gt1": int((train["RevolvingUtilizationOfUnsecuredLines"] > 1).sum())}
for c in ["NumberOfTime30-59DaysPastDueNotWorse","NumberOfTimes90DaysLate","NumberOfTime60-89DaysPastDueNotWorse"]:
    audit[f"{c}_sentinel_96_98"] = int(train[c].isin([96,98]).sum())
audit["DebtRatio_q"] = {str(k): float(v) for k,v in train["DebtRatio"].quantile([.5,.9,.99,.995]).items()}
audit["MonthlyIncome_q"] = {str(k): float(v) for k,v in train["MonthlyIncome"].quantile([.5,.9,.99,.995]).items()}
audit["dup_feature_rows"] = int(train[features].duplicated().sum())
print(json.dumps(audit, indent=2, default=str))

# ---- median impute, fit ONLY on 120k train ----
impute_cols = ["MonthlyIncome","NumberOfDependents"]
medians = {c: float(train[c].median()) for c in impute_cols}
print("medians:", medians)
def prep(df):
    X = df[features].copy()
    for c, m in medians.items():
        X[c] = X[c].fillna(m)
    return X

Xfree_full = prep(train)
Xte  = prep(test)
Xval = prep(val)

# internal holdout for early stopping (fixed val labels never touched here)
Xtr, Xho, ytr, yho = train_test_split(Xfree_full, y, test_size=0.15, stratify=y, random_state=SEED)

model = lgb.LGBMClassifier(objective="binary", num_leaves=31, learning_rate=0.05,
                           n_estimators=600, subsample=0.9, colsample_bytree=0.9,
                           random_state=SEED, n_jobs=4, metric="auc", verbose=-1)
model.fit(Xtr, ytr, eval_set=[(Xho, yho)], eval_metric="auc",
          callbacks=[lgb.early_stopping(50, verbose=False), lgb.log_evaluation(0)])
ho_auc = roc_auc_score(yho, model.predict_proba(Xho)[:,1])
print("holdout AUC:", ho_auc, "best_iter:", model.best_iteration_)

val_prob  = model.predict_proba(Xval)[:,1]
test_prob = model.predict_proba(Xte)[:,1]
for nm, p in [("val", val_prob), ("test", test_prob)]:
    assert np.isfinite(p).all() and p.min() >= 0 and p.max() <= 1, nm
print("val_prob range:", val_prob.min(), val_prob.max())

# ---- outputs ----
os.makedirs("artifacts", exist_ok=True)
val_out = pd.DataFrame({"Id": val["Id"].values, "Probability": val_prob})
assert len(val_out) == 30000 and val_out["Id"].is_unique
val_out.to_csv("validation_predictions.csv", index=False)

pred_out = pd.DataFrame({"Id": test["Id"].values, "Probability": test_prob})
assert len(pred_out) == 101503 and list(pred_out.columns) == ["Id","Probability"]
assert pred_out["Id"].is_unique
pred_out.to_csv("predictions.csv", index=False)

# ---- artifacts ----
model.booster_.save_model("artifacts/lgbm_baseline.txt")
json.dump({"medians": medians, "features": features, "holdout_auc": ho_auc,
           "best_iteration": int(model.best_iteration_), "audit": audit,
           "params": {"num_leaves":31,"lr":0.05,"n_estimators":600,"seed":SEED,"n_jobs":4}},
          open("artifacts/run_meta.json","w"), indent=2, default=str)
with open("artifacts/run_log.txt","w") as f:
    f.write(f"LightGBM median-impute baseline\nholdout_auc={ho_auc:.6f}\n"
            f"best_iteration={model.best_iteration_}\nfeatures={features}\n"
            f"impute_medians={medians}\n")
with open("artifacts/README.md","w") as f:
    f.write("# Inference\n1) read features list from run_meta.json\n"
            "2) fillna MonthlyIncome/NumberOfDependents with stored medians\n"
            "3) booster.predict -> pos prob\n")
print("done; rows:", len(val_out), len(pred_out))
