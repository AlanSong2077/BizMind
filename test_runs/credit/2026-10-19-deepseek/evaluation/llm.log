 split (test_size=0.2, random_state=42, stratify on SeriousDlqin2yrs) on the original row order of train_data/train.csv. It keeps only the 120000 training rows (with labels) in the public directory, writes the 30000 validation feature rows (labels stripped) to public/validation_data/, and stores the validation labels only in the private directory. The unchanged unlabeled prediction set is copied to public/predict_data/. Id is never used as a feature but is preserved for alignment. A smoke-test sample prediction file (constant 0.5 probability, valid Ids) is generated so evaluate.py can be tested. All paths are command-line driven, no hidden files are read, and no source files are modified.\n</explanation>\n<code>#!/usr/bin/env python3\n"""Create the public/private split for the Give Me Some Credit task.\n\nLayout produced under --public_dir:\n    train_data/train.csv                     120000 labeled training rows\n    validation_data/validation_features.csv  30000 unlabeled validation rows\n    validation_data/validation_sample_predictions.csv  smoke-test predictions\n    predict_data/test.csv                    unchanged 101503-row prediction set\n\nUnder --private_dir:\n    validation_labels.csv                    Id,SeriousDlqin2yrs (labels only)\n\nSplit: single stratified 80/20 split on original row order,\ntest_size=0.2, random_state=42, stratify on SeriousDlqin2yrs.\n"""\nimport argparse\nimport json\nimport os\n\nimport pandas as pd\nfrom sklearn.model_selection import train_test_split\n\nTARGET = "SeriousDlqin2yrs"\nID = "Id"\nRANDOM_STATE = 42\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--input_dir", required=True,\n                        help="Directory containing train_data/ and predict_data/")\n    parser.add_argument("--public_dir", required=True)\n    parser.add_argument("--private_dir", required=True)\n    args = parser.parse_args()\n\n    train_path = os.path.join(args.input_dir, "train_data", "train.csv")\n    test_path = os.path.join(args.input_dir, "predict_data", "test.csv")\n\n    if not os.path.isfile(train_path):\n        raise SystemExit(f"Missing training file: {train_path}")\n    if not os.path.isfile(test_path):\n        raise SystemExit(f"Missing prediction file: {test_path}")\n\n    train = pd.read_csv(train_path)\n    test = pd.read_csv(test_path)\n\n    if TARGET not in train.columns:\n        raise SystemExit(f"Training file missing target column \'{TARGET}\'")\n    if ID not in train.columns or ID not in test.columns:\n        raise SystemExit(f"Missing id column \'{ID}\'")\n\n    # Recreate the evaluator\'s single stratified split on the original row order.\n    train_rows, val_rows = train_test_split(\n        train,\n        test_size=0.2,\n        random_state=RANDOM_STATE,\n        stratify=train[TARGET],\n    )\n\n    # Preserve original row order within each part (train_test_split shuffles).\n    train_rows = train_rows.sort_index()\n    val_rows = val_rows.sort_index()\n\n    feature_cols = [c for c in test.columns if c != ID]\n    val_features = val_rows[[ID] + feature_cols].reset_index(drop=True)\n    val_labels = val_rows[[ID, TARGET]].reset_index(drop=True)\n\n    # Directories.\n    pub_train_dir = os.path.join(args.public_dir, "train_data")\n    pub_val_dir = os.path.join(args.public_dir, "validation_data")\n    pub_pred_dir = os.path.join(args.public_dir, "predict_data")\n    for d in (pub_train_dir, pub_val_dir, pub_pred_dir, args.private_dir):\n        os.makedirs(d, exist_ok=True)\n\n    # Public: training split (labels present, only training rows).\n    train_out = os.path.join(pub_train_dir, "train.csv")\n    train_rows.reset_index(drop=True).to_csv(train_out, index=False)\n\n    # Public: unlabeled validation inputs.\n    val_feat_out = os.path.join(pub_val_dir, "validation_features.csv")\n    val_features.to_csv(val_feat_out, index=False)\n\n    # Public: smoke-test predictions (constant 0.5 probability, valid Ids).\n    sample = pd.DataFrame({\n        ID: val_features[ID].values,\n        "Probability": [0.5] * len(val_features),\n    })\n    sample_out = os.path.join(pub_val_dir, "validation_sample_predictions.csv")\n    sample.to_csv(sample_out, index=False)\n\n    # Public: unchanged unlabeled prediction set (original order, original Ids).\n    pred_out = os.path.join(pub_pred_dir, "test.csv")\n    test.to_csv(pred_out, index=False)\n\n    # Private: validation labels only.\n    label_out = os.path.join(args.private_dir, "validation_labels.csv")\n    val_labels.to_csv(label_out, index=False)\n\n    # Schema / layout documentation.\n    schema = {\n        "problem_type": "binary_classification",\n        "target": TARGET,\n        "id_column": ID,\n        "feature_columns": feature_cols,\n        "split_strategy": (\n            "train_test_split(test_size=0.2, random_state=42, "\n            f"stratify=train[\'{TARGET}\']) on original row order"\n        ),\n        "train_rows": int(len(train_rows)),\n        "validation_rows": int(len(val_features)),\n        "prediction_rows": int(len(test)),\n        "train_positive_rate": float(train_rows[TARGET].mean()),\n        "files": {\n            "public_train": train_out,\n            "public_validation_features": val_feat_out,\n            "public_validation_sample_predictions": sample_out,\n            "public_predict": pred_out,\n            "private_validation_labels": label_out,\n        },\n    }\n    with open(os.path.join(args.public_dir, "split_info.json"), "w") as f:\n        json.dump(schema, f, indent=2)\n\n    print("Split strategy:", schema["split_strategy"])\n    print(f"Train rows:       {schema[\'train_rows\']}  (pos rate {schema[\'train_positive_rate\']:.5f})")\n    print(f"Validation rows:  {schema[\'validation_rows\']}")\n    print(f"Prediction rows:  {schema[\'prediction_rows\']}")\n    print("Public files:")\n    print(" ", train_out)\n    print(" ", val_feat_out)\n    print(" ", sample_out)\n    print(" ", pred_out)\n    print("Private files:")\n    print(" ", label_out)\n    print("  ->", os.path.join(args.public_dir, "split_info.json"))\n\n\nif __name__ == "__main__":\n    main()\n</code>\n\n<current_file>evaluate.py</current_file>\n<explanation>\nThe evaluator loads the private validation labels, then validates the submitted predictions: required columns present, no duplicates, exact ID coverage (no missing/extra), finite probabilities in [0,1]. It aligns rows by Id (merging on the label Ids) and computes roc_auc_score on the positive-class probability. Any structural problem returns a descriptive failure with score null and writes the JSON report; it never trains a model or alters the split. The report is written to private_dir/eval_report.json with the exact required schema and also printed.\n</explanation>\n<code>#!/usr/bin/env python3\n"""Evaluate validation predictions against private labels using ROC-AUC."""\nimport argparse\nimport json\nimport os\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.metrics import roc_auc_score\n\nID = "Id"\nTARGET = "SeriousDlqin2yrs"\nPROB = "Probability"\n\n\ndef write_report(private_dir, score, success, message):\n    os.makedirs(private_dir, exist_ok=True)\n    report = {"score": score, "success": success, "message": message}\n    path = os.path.join(private_dir, "eval_report.json")\n    with open(path, "w") as f:\n        json.dump(report, f, indent=2)\n    print(json.dumps(report, indent=2))\n    return report\n\n\ndef fail(private_dir, message):\n    return write_report(private_dir, None, False, message)\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--public_dir", required=True)\n    parser.add_argument("--private_dir", required=True)\n    parser.add_argument("--pred", required=True, help="Prediction CSV path")\n    args = parser.parse_args()\n\n    label_path = os.path.join(args.private_dir, "validation_labels.csv")\n    if not os.path.isfile(label_path):\n        return fail(args.private_dir, f"Missing private labels: {label_path}")\n    if not os.path.isfile(args.pred):\n        return fail(args.private_dir, f"Missing prediction file: {args.pred}")\n\n    labels = pd.read_csv(label_path)\n    if ID not in labels.columns or TARGET not in labels.columns:\n        return fail(args.private_dir,\n                    f"Labels file must contain \'{ID}\' and \'{TARGET}\'")\n\n    try:\n        pred = pd.read_csv(args.pred)\n    except Exception as exc:  # noqa: BLE001\n        return fail(args.private_dir, f"Could not read prediction file: {exc}")\n\n    missing = [c for c in (ID, PROB) if c not in pred.columns]\n    if missing:\n        return fail(args.private_dir,\n                    f"Prediction file missing columns {missing}; "\n                    f"found {list(pred.columns)}")\n\n    if len(pred) == 0:\n        return fail(args.private_dir, "Prediction file is empty")\n\n    if pred[ID].duplicated().any():\n        dup = pred.loc[pred[ID].duplicated(), ID].tolist()[:5]\n        return fail(args.private_dir, f"Duplicate Ids in predictions, e.g. {dup}")\n\n    label_ids = set(labels[ID].tolist())\n    pred_ids = set(pred[ID].tolist())\n    missing_ids = label_ids - pred_ids\n    extra_ids = pred_ids - label_ids\n    if missing_ids:\n        return fail(args.private_dir,\n                    f"Missing {len(missing_ids)} validation Ids, "\n                    f"e.g. {sorted(missing_ids)[:5]}")\n    if extra_ids:\n        return fail(args.private_dir,\n                    f"Found {len(extra_ids)} extra Ids not in validation set, "\n                    f"e.g. {sorted(extra_ids)[:5]}")\n\n    prob = pd.to_numeric(pred[PROB], errors="coerce")\n    if prob.isna().any():\n        return fail(args.private_dir, "Prediction contains non-numeric Probability")\n    if not np.isfinite(prob.to_numpy()).all():\n        return fail(args.private_dir, "Prediction contains non-finite Probability")\n    if (prob < 0).any() or (prob > 1).any():\n        return fail(args.private_dir,\n                    "Probability out of [0,1]; must be predict_proba class-1 prob")\n\n    merged = labels[[ID, TARGET]].merge(\n        pd.DataFrame({ID: pred[ID].values, PROB: prob.values}),\n        on=ID, how="inner",\n    )\n    if len(merged) != len(labels):\n        return fail(args.private_dir,\n                    f"Row count mismatch after alignment: {len(merged)} vs {len(labels)}")\n\n    score = roc_auc_score(merged[TARGET].to_numpy(), merged[PROB].to_numpy())\n    return write_report(args.private_dir, float(score), True, "")\n\n\nif __name__ == "__main__":\n    main()\n</code>'}, {'role': 'user', 'content': "Execution success: True\nOutput:\nSplit strategy: train_test_split(test_size=0.2, random_state=42, stratify=train['SeriousDlqin2yrs']) on original row order\nTrain rows:       120000  (pos rate 0.06684)\nValidation rows:  30000\nPrediction rows:  101503\nPublic files:\n  <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/public/train_data/train.csv\n  <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/public/validation_data/validation_features.csv\n  <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/public/validation_data/validation_sample_predictions.csv\n  <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/public/predict_data/test.csv\nPrivate files:\n  <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/private/validation_labels.csv\n  -> <PROJECT_ROOT>/workspace/credit-risk-local/20261019_000911_388741/evaluation/public/split_info.json\nError: \nCorrect failures or generate the next script. Use the same current_file/explanation/code tags. Return None only after both scripts work."}, {'role': 'assistant', 'content': "<current_file>None</current_file>\n<explanation>Both scripts executed successfully. split_dataset.py produced the expected layout: 120000 labeled training rows (positive rate 0.06684 matc